---
// MainLayout.astro - Componente de layout principal para TracingPBA
// Versión mejorada con optimización SEO, soporte para videos y corrección de errores TypeScript

import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';

const { 
  title = "TracingPBA | Software de Trazabilidad 360° para Plantas de Beneficio Animal | Transformia",
  description = "Sistema de trazabilidad 360° para plantas de beneficio animal. Automatiza SINIGAN, precintos y reportes para cumplimiento normativo en Colombia.",
  image = "https://tracingpba.transformia.dev/images/tracingpba-social-preview.jpg",
  canonicalUrl = Astro.url.pathname
} = Astro.props;

// Obtener la URL completa para la URL canónica
const siteUrl = "https://tracingpba.transformia.dev";
const fullCanonicalUrl = `${siteUrl}${canonicalUrl}`;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  
  <!-- SEO Meta Tags -->
  <meta name="description" content={description}>
  <meta name="keywords" content="trazabilidad animal, software trazabilidad, trazabilidad cárnica, plantas de beneficio animal, SINIGAN, precintos digitales, trazabilidad 360, software PBA, trazabilidad Colombia">
  <meta name="robots" content="index, follow">
  <meta name="author" content="Transformia">
  
  <!-- Canonical URL -->
  <link rel="canonical" href={fullCanonicalUrl}>
  
  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="manifest" href="/site.webmanifest">
  
  <!-- Precargar fuentes críticas -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link rel="preload" href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap" as="style">
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&family=Space+Mono:ital,wght@0,400;0,700;1,400;1,700&display=swap" rel="stylesheet">
  
  <!-- Open Graph / Social Media Meta Tags -->
  <meta property="og:type" content="website">
  <meta property="og:url" content={fullCanonicalUrl}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={image}>
  <meta property="og:site_name" content="TracingPBA">
  
  <!-- Twitter -->
  <meta property="twitter:card" content="summary_large_image">
  <meta property="twitter:url" content={fullCanonicalUrl}>
  <meta property="twitter:title" content={title}>
  <meta property="twitter:description" content={description}>
  <meta property="twitter:image" content={image}>
  
  <!-- SEO -->
  <title>{title}</title>
  
  <!-- Structured Data (Schema.org) -->
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "SoftwareApplication",
      "name": "TracingPBA",
      "applicationCategory": "BusinessApplication",
      "operatingSystem": "Cloud-based",
      "offers": {
        "@type": "Offer",
        "price": "Contactar para cotización",
        "priceCurrency": "COP"
      },
      "description": "Sistema de trazabilidad 360° para plantas de beneficio animal. Automatiza SINIGAN, precintos y reportes en una sola suite cloud.",
      "aggregateRating": {
        "@type": "AggregateRating",
        "ratingValue": "4.8",
        "ratingCount": "45"
      },
      "featureList": "Gestión de precintos digitales, Automatización SINIGAN, Dashboard de trazabilidad, Reportes regulatorios, Trazabilidad documental",
      "screenshot": "https://tracingpba.transformia.dev/images/dashboard-screenshot.jpg",
      "softwareVersion": "2.5",
      "author": {
        "@type": "Organization",
        "name": "Transformia",
        "url": "https://transformia.dev"
      }
    }
  </script>
  
  <!-- Estilos críticos base -->
  <style is:global>
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }
    
    html, body {
      margin: 0;
      padding: 0;
      font-family: 'Space Grotesk', sans-serif;
      background-color: #0a0a14;
      color: white;
      overflow-x: hidden;
      width: 100%;
      height: 100%;
      scroll-behavior: smooth;
      scroll-padding-top: 80px; /* Altura del navbar */
    }
    
    /* Variables CSS específicas para TracingPBA */
    :root {
      --font-sans: 'Space Grotesk', sans-serif;
      --font-mono: 'Space Mono', monospace;
      
      --color-dark: #0a2e36;
      --color-dark-blue: #0e3b42;
      --color-dark-purple: #124a50;
      --neon-purple: #b042ff;
      --neon-blue: #4287ff;
      --neon-pink: #ff42b0;
      
      --tracingpba-dark: #0a2e36;
      --tracingpba-teal: #3bdfb4;
      --tracingpba-red: #e74c3c;
      --tracingpba-light: #f0f7f4;
      --tracingpba-yellow: #e6cb44;
      --tracingpba-accent: #4fb06e;
    }
  </style>
   
</head>
<body>
  <!-- Navbar Component -->
  <Navbar />

  <!-- Contenido principal -->
  <main id="content" role="main">
    <slot />
  </main>
  
  <!-- Footer Component -->
  <Footer />
  
  <!-- Botón de volver arriba -->
  <button id="back-to-top" class="back-to-top-btn" aria-label="Volver arriba">
    <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <polyline points="18 15 12 9 6 15"></polyline>
    </svg>
  </button>

  <!-- JavaScript mejorado con correcciones TypeScript y soporte para videos -->
  <script is:inline>
    document.addEventListener('DOMContentLoaded', function() {
      // Variables para elementos interactivos
      var backToTopBtn = document.getElementById('back-to-top');
      
      // Función para mostrar/ocultar botón de volver arriba
      function handleScroll() {
        if (backToTopBtn) {
          if (window.scrollY > 300) {
            backToTopBtn.classList.add('visible');
          } else {
            backToTopBtn.classList.remove('visible');
          }
        }
      }
      
      // Evento de scroll optimizado con requestAnimationFrame
      var scrollTimeout = null;
      window.addEventListener('scroll', function() {
        if (!scrollTimeout) {
          scrollTimeout = window.requestAnimationFrame(function() {
            handleScroll();
            scrollTimeout = null;
          });
        }
      });
      
      // Inicializar estado de scroll
      handleScroll();
      
      // Botón de volver arriba
      if (backToTopBtn) {
        backToTopBtn.addEventListener('click', function() {
          window.scrollTo({
            top: 0,
            behavior: 'smooth'
          });
        });
      }
      
      // Función para animaciones al hacer scroll
      function animateOnScroll() {
        var elements = document.querySelectorAll('.animate-on-scroll, .video-fade-in');
        
        for (var i = 0; i < elements.length; i++) {
          var element = elements[i];
          var elementPosition = element.getBoundingClientRect().top;
          var windowHeight = window.innerHeight;
          
          if (elementPosition < windowHeight * 0.85) {
            element.classList.add('visible');
          }
        }
      }
      
      // Inicializar animaciones
      setTimeout(animateOnScroll, 100);
      
      // Event listener para animaciones al hacer scroll (optimizado)
      var animationTimeout = null;
      window.addEventListener('scroll', function() {
        if (!animationTimeout) {
          animationTimeout = window.requestAnimationFrame(function() {
            animateOnScroll();
            animationTimeout = null;
          });
        }
      });
      
      // Añadir efecto de desplazamiento suave para enlaces internos
      var anchors = document.querySelectorAll('a[href^="#"]:not([role="tab"])');
      for (var i = 0; i < anchors.length; i++) {
        anchors[i].addEventListener('click', function(e) {
          var href = this.getAttribute('href');
          
          if (!href || href === '#') return;
          
          var targetElement = document.querySelector(href);
          
          if (targetElement) {
            e.preventDefault();
            
            var headerElement = document.querySelector('.site-header');
            var headerHeight = headerElement instanceof HTMLElement ? headerElement.offsetHeight : 0;
            var targetPosition = targetElement.getBoundingClientRect().top + window.scrollY - headerHeight - 20;
            
            window.scrollTo({
              top: targetPosition,
              behavior: 'smooth'
            });
            
            // Actualizar la URL sin recargar la página
            history.pushState(null, '', href);
          }
        });
      }

      // Añadir clase a la página cargada para activar animaciones
      document.body.classList.add('page-loaded');
      
      // Efecto de parallax suave para elementos decorativos
      if ('requestAnimationFrame' in window) {
        var parallaxElements = document.querySelectorAll('.parallax-element');
        
        function updateParallax() {
          var scrollY = window.scrollY;
          
          for (var i = 0; i < parallaxElements.length; i++) {
            var element = parallaxElements[i];
            var speedAttr = element.getAttribute('data-speed');
            var speed = speedAttr ? parseFloat(speedAttr) : 0.1;
            var offset = scrollY * speed;
            
            if (element instanceof HTMLElement) {
              element.style.transform = 'translateY(' + offset + 'px)';
            }
          }
          
          requestAnimationFrame(updateParallax);
        }
        
        requestAnimationFrame(updateParallax);
      }
      
      // --- Manejo de videos ---
      
      // Inicializar videos lazy-load
      var videos = document.querySelectorAll('video[data-src]');
      
      function handleVideoIntersection(entries, observer) {
        entries.forEach(function(entry) {
          if (entry.isIntersecting) {
            var video = entry.target;
            var src = video.getAttribute('data-src');
            
            if (src) {
              // Crear source element
              var source = document.createElement('source');
              source.src = src;
              source.type = 'video/mp4';
              
              // Añadir source al video
              video.appendChild(source);
              
              // Iniciar carga
              video.load();
              
              // Reproducir automáticamente si tiene el atributo
              if (video.hasAttribute('autoplay')) {
                video.play().catch(function(error) {
                  console.log('Autoplay prevented: ', error);
                });
              }
              
              // Remover atributo data-src para no volver a cargar
              video.removeAttribute('data-src');
              
              // Dejar de observar este video
              observer.unobserve(video);
            }
          }
        });
      }
      
      // Configurar IntersectionObserver para videos
      if ('IntersectionObserver' in window) {
        var videoObserver = new IntersectionObserver(handleVideoIntersection, {
          rootMargin: '100px 0px',
          threshold: 0.1
        });
        
        videos.forEach(function(video) {
          videoObserver.observe(video);
        });
      } else {
        // Fallback para navegadores sin IntersectionObserver
        videos.forEach(function(video) {
          var src = video.getAttribute('data-src');
          if (src) {
            var source = document.createElement('source');
            source.src = src;
            source.type = 'video/mp4';
            video.appendChild(source);
            video.load();
            video.removeAttribute('data-src');
          }
        });
      }
      
      // Controles personalizados para videos
      var videoContainers = document.querySelectorAll('.video-with-controls');
      
      videoContainers.forEach(function(container) {
        var video = container.querySelector('video');
        var playBtn = container.querySelector('.video-play-btn');
        var muteBtn = container.querySelector('.video-mute-btn');
        var fullscreenBtn = container.querySelector('.video-fullscreen-btn');
        var progressBar = container.querySelector('.video-progress-bar');
        var progressContainer = container.querySelector('.video-progress');
        
        if (!video) return;
        
        // Play/Pause
        if (playBtn) {
          playBtn.addEventListener('click', function() {
            if (video.paused) {
              video.play();
              playBtn.innerHTML = `
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="6" y="4" width="4" height="16"></rect>
                  <rect x="14" y="4" width="4" height="16"></rect>
                </svg>
              `;
            } else {
              video.pause();
              playBtn.innerHTML = `
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="5 3 19 12 5 21 5 3"></polygon>
                </svg>
              `;
            }
          });
        }
        
        // Mute/Unmute
        if (muteBtn) {
          muteBtn.addEventListener('click', function() {
            video.muted = !video.muted;
            
            if (video.muted) {
              muteBtn.innerHTML = `
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                  <line x1="23" y1="9" x2="17" y2="15"></line>
                  <line x1="17" y1="9" x2="23" y2="15"></line>
                </svg>
              `;
            } else {
              muteBtn.innerHTML = `
                <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <polygon points="11 5 6 9 2 9 2 15 6 15 11 19 11 5"></polygon>
                  <path d="M15.54 8.46a5 5 0 0 1 0 7.07"></path>
                  <path d="M19.07 4.93a10 10 0 0 1 0 14.14"></path>
                </svg>
              `;
            }
          });
        }
        
        // Fullscreen
        if (fullscreenBtn) {
          fullscreenBtn.addEventListener('click', function() {
            if (video.requestFullscreen) {
              video.requestFullscreen();
            } else if (video.webkitRequestFullscreen) {
              video.webkitRequestFullscreen();
            } else if (video.msRequestFullscreen) {
              video.msRequestFullscreen();
            }
          });
        }
        
        // Actualizar barra de progreso
        if (progressBar && video) {
          video.addEventListener('timeupdate', function() {
            var progress = (video.currentTime / video.duration) * 100;
            progressBar.style.width = progress + '%';
          });
          
          // Clic en la barra de progreso
          if (progressContainer) {
            progressContainer.addEventListener('click', function(e) {
              var rect = progressContainer.getBoundingClientRect();
              var pos = (e.clientX - rect.left) / rect.width;
              video.currentTime = pos * video.duration;
            });
          }
        }
        
        // Auto-restart videos en loop
        if (video.hasAttribute('loop')) {
          video.addEventListener('ended', function() {
            video.currentTime = 0;
            video.play();
          });
        }
        
        // Pausar videos cuando no son visibles
        var videoIntersectionObserver = new IntersectionObserver(function(entries) {
          entries.forEach(function(entry) {
            // Solo afecta a videos con autoplay
            if (video.hasAttribute('autoplay')) {
              if (entry.isIntersecting) {
                // El video está visible, intentar reproducir
                video.play().catch(function(error) {
                  console.log('Autoplay prevented: ', error);
                });
              } else {
                // El video no está visible, pausar
                video.pause();
              }
            }
          });
        }, { threshold: 0.2 });
        
        videoIntersectionObserver.observe(video);
      });
    });
  </script>
</body>
</html>
---
// Navbar.astro - Barra de navegación con diseño cyberpunk para TracingPBA
---

<header id="header" class="site-header">
    <!-- Fondo con efecto blur para navbar -->
    <div class="header-background"></div>
    
    <!-- Línea de flash estática en la parte superior -->
    <div class="flash-line"></div>
    
    <!-- Barra de navegación principal -->
    <nav class="main-navbar">
      <div class="container-for-navbar">
        <div class="navbar-content">
          <!-- Logo -->
          <a href="/" class="navbar-logo">
            <span class="logo-transformia">TRANSFORMIA</span>
            <span class="logo-slash">/</span>
            <span class="logo-product">TRACINGPBA</span>
          </a>
          
          <!-- Espacio flexible -->
          <div class="flex-spacer"></div>
          
          <!-- Menú de navegación - Con posición fija como en la imagen -->
          <div class="navbar-menu" id="navbar-menu">
            <ul class="menu-items">
              <li class="menu-item">
                <a href="#problemsolution" class="menu-link">
                  <span class="link-number">01</span>
                  <span class="link-text">Problema/Solución</span>
                </a>
              </li>
              <li class="menu-item">
                <a href="#modules" class="menu-link">
                  <span class="link-number">02</span>
                  <span class="link-text">Módulos</span>
                </a>
              </li>
              <li class="menu-item">
                <a href="#dashboard" class="menu-link">
                  <span class="link-number">03</span>
                  <span class="link-text">Dashboard</span>
                </a>
              </li>
              <li class="menu-item">
                <a href="#precintos" class="menu-link">
                  <span class="link-number">04</span>
                  <span class="link-text">Precintos</span>
                </a>
              </li>
              <li class="menu-item">
                <a href="#reportes" class="menu-link">
                  <span class="link-number">05</span>
                  <span class="link-text">Reportes</span>
                </a>
              </li>
            </ul>
          </div>
          
          <!-- Botón menú móvil -->
          <button class="menu-toggle" id="menu-toggle" aria-label="Abrir menú">
            <div class="toggle-line"></div>
            <div class="toggle-line"></div>
            <div class="toggle-line"></div>
          </button>
        </div>
      </div>
    </nav>
    
    <!-- Menú móvil -->
    <div class="mobile-menu" id="mobile-menu">
      <div class="mobile-menu-header">
        <span class="mobile-menu-title">MENÚ</span>
        <button class="mobile-menu-close" id="mobile-menu-close" aria-label="Cerrar menú">
          <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"></line>
            <line x1="6" y1="6" x2="18" y2="18"></line>
          </svg>
        </button>
      </div>
      
      <ul class="mobile-menu-items">
        <li class="mobile-menu-item">
          <a href="#problemsolution" class="mobile-menu-link">
            <span class="link-number">01</span>
            <span class="link-text">Problema/Solución</span>
          </a>
        </li>
        <li class="mobile-menu-item">
          <a href="#modules" class="mobile-menu-link">
            <span class="link-number">02</span>
            <span class="link-text">Módulos</span>
          </a>
        </li>
        <li class="mobile-menu-item">
          <a href="#dashboard" class="mobile-menu-link">
            <span class="link-number">03</span>
            <span class="link-text">Dashboard</span>
          </a>
        </li>
        <li class="mobile-menu-item">
          <a href="#precintos" class="mobile-menu-link">
            <span class="link-number">04</span>
            <span class="link-text">Precintos</span>
          </a>
        </li>
        <li class="mobile-menu-item">
          <a href="#reportes" class="mobile-menu-link">
            <span class="link-number">05</span>
            <span class="link-text">Reportes</span>
          </a>
        </li>
      </ul>
      
      <div class="mobile-branding">
        <div class="tracingpba-badge">
          <span class="badge-text">TRAZABILIDAD 360°</span>
        </div>
      </div>
    </div>
  </header>
  
  <style>
    /* Variables y estilos base - Colores corregidos con mejor contraste */
    :root {
      --neon-purple: #b042ff;
      --tracingpba-teal: #3bdfb4;
      --tracingpba-dark: #0a2e36;
      --tracingpba-accent: #4fb06e;
      --tracingpba-light: #f0f7f4;
      --dark-bg: #0a0a14;
      --header-bg: rgba(10, 10, 20, 0.9);
      --header-height: 80px; /* Altura ajustada como en Transformia */
    }
    
    .site-header {
      position: fixed;
      top: 0;
      left: 0;
      width: 100%;
      z-index: 1000;
      font-family: 'Space Grotesk', sans-serif;
    }
    
    /* Cambio de nombre para evitar conflictos */
    .container-for-navbar {
      width: 90%;
      max-width: 1280px;
      margin: 0 auto;
      height: 100%;
      display: flex;
      align-items: center;
    }
    
    /* Fondo con efecto blur */
    .header-background {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: var(--header-bg);
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      z-index: -1;
      border-bottom: 1px solid rgba(59, 223, 180, 0.3);
    }
    
    /* Línea de flash estática en la parte superior */
    .flash-line {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 2px;
      background: linear-gradient(to right, 
        transparent 0%, 
        var(--tracingpba-teal) 30%, 
        var(--tracingpba-teal) 70%, 
        transparent 100%
      );
      z-index: 1;
      opacity: 0.7;
      animation: flash 3s infinite;
    }
    
    @keyframes flash {
      0%, 100% {
        opacity: 0.3;
      }
      50% {
        opacity: 0.8;
      }
    }
    
    /* Barra de navegación principal */
    .main-navbar {
      height: var(--header-height);
      display: flex;
      align-items: center;
    }
    
    .navbar-content {
      display: flex;
      align-items: center;
      width: 100%;
      height: 100%;
    }
    
    /* Logo */
    .navbar-logo {
      display: flex;
      align-items: center;
      text-decoration: none;
      flex: 0 0 auto;
      height: 100%;
      padding: 0;
    }
    
    .logo-transformia {
      font-family: 'Space Mono', monospace;
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--neon-purple);
      letter-spacing: 1px;
    }
    
    .logo-slash {
      margin: 0 0.3rem;
      color: rgba(255, 255, 255, 0.5);
    }
    
    .logo-product {
      font-family: 'Space Mono', monospace;
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--tracingpba-teal);
      letter-spacing: 1px;
    }
    
    /* Espaciador flexible para empujar el menú a la derecha */
    .flex-spacer {
      flex: 1;
    }
    
    /* Menú de navegación - Alineación precisa como en la imagen */
    .navbar-menu {
      height: 100%;
      display: flex;
      align-items: center;
    }
    
    .menu-items {
      display: flex;
      list-style: none;
      padding: 0;
      margin: 0;
      height: 100%;
    }
    
    .menu-item {
      height: 100%;
      position: relative;
      display: flex;
      align-items: center;
    }
    
    /* Ajustes precisos para cada ítem del menú basado en la imagen */
    .menu-item:nth-child(1) { width: 170px; }
    .menu-item:nth-child(2) { width: 100px; }
    .menu-item:nth-child(3) { width: 110px; }
    .menu-item:nth-child(4) { width: 100px; }
    .menu-item:nth-child(5) { width: 110px; }
    
    .menu-link {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      height: 100%;
      width: 100%;
      color: rgba(255, 255, 255, 0.9);
      text-decoration: none;
      transition: all 0.3s ease;
      position: relative;
      text-align: center;
      padding: 0;
    }
    
    .link-number {
      font-family: 'Space Mono', monospace;
      font-size: 0.7rem;
      color: rgba(59, 223, 180, 0.9);
      margin-bottom: 0.3rem;
      font-weight: 700;
      transition: all 0.3s ease;
      line-height: 1;
      position: relative;
      top: -2px; /* Ajuste fino para alineación vertical */
    }
    
    .link-text {
      font-family: 'Space Grotesk', sans-serif;
      font-size: 0.9rem;
      letter-spacing: 0.5px;
      transition: all 0.3s ease;
      white-space: nowrap;
      position: relative;
      line-height: 1;
    }
    
    .menu-link::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 50%;
      width: 0;
      height: 3px;
      background: var(--tracingpba-teal);
      transition: all 0.3s ease;
      transform: translateX(-50%);
      opacity: 0;
    }
    
    .menu-link:hover {
      color: var(--tracingpba-teal);
    }
    
    .menu-link:hover .link-number {
      transform: translateY(-2px);
      color: var(--tracingpba-teal);
    }
    
    .menu-link:hover .link-text {
      transform: translateY(2px);
    }
    
    .menu-link:hover::after {
      width: 60%;
      opacity: 1;
      box-shadow: 0 0 10px rgba(59, 223, 180, 0.5);
    }
    
    /* Botón menú móvil */
    .menu-toggle {
      display: none;
      flex-direction: column;
      justify-content: space-between;
      width: 30px;
      height: 20px;
      background: transparent;
      border: none;
      cursor: pointer;
      padding: 0;
      z-index: 10;
      margin-left: 20px;
      flex: 0 0 auto;
    }
    
    .toggle-line {
      width: 100%;
      height: 2px;
      background-color: var(--tracingpba-teal);
      transition: all 0.3s ease;
    }
    
    /* Menú móvil - Color actualizado */
    .mobile-menu {
      position: fixed;
      top: 0;
      right: -100%;
      width: 100%;
      max-width: 400px;
      height: 100vh;
      background: rgba(10, 10, 30, 0.95); /* Fondo actualizado para mejor contraste */
      backdrop-filter: blur(10px);
      -webkit-backdrop-filter: blur(10px);
      z-index: 1001;
      padding: 1.5rem;
      transition: right 0.3s ease;
      display: flex;
      flex-direction: column;
      border-left: 1px solid rgba(59, 223, 180, 0.3);
      box-shadow: -5px 0 20px rgba(0, 0, 0, 0.3);
    }
    
    .mobile-menu.active {
      right: 0;
    }
    
    .mobile-menu-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-bottom: 2rem;
      border-bottom: 1px solid rgba(59, 223, 180, 0.2);
      padding-bottom: 1rem;
    }
    
    .mobile-menu-title {
      font-family: 'Space Mono', monospace;
      font-size: 1.2rem;
      font-weight: 700;
      color: var(--tracingpba-teal);
      letter-spacing: 2px;
    }
    
    .mobile-menu-close {
      background: transparent;
      border: none;
      color: var(--tracingpba-teal);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 0.5rem;
      transition: all 0.3s ease;
    }
    
    .mobile-menu-close:hover {
      transform: rotate(90deg);
    }
    
    .mobile-menu-items {
      list-style: none;
      padding: 0;
      margin: 0 0 2rem;
    }
    
    .mobile-menu-item {
      margin-bottom: 1.5rem;
      border-bottom: 1px solid rgba(59, 223, 180, 0.1);
      padding-bottom: 1rem;
    }
    
    .mobile-menu-link {
      display: flex;
      align-items: center;
      gap: 1rem;
      color: white;
      text-decoration: none;
      transition: all 0.3s ease;
      padding: 0.5rem 0;
    }
    
    .mobile-menu-link .link-number {
      font-size: 0.9rem;
      margin-bottom: 0;
      opacity: 0.9;
      color: var(--tracingpba-teal);
      position: static;
      top: 0;
    }
    
    .mobile-menu-link .link-text {
      font-size: 1.1rem;
      position: static;
    }
    
    .mobile-menu-link:hover {
      color: var(--tracingpba-teal);
      transform: translateX(10px);
    }
    
    /* Branding móvil en lugar de contacto */
    .mobile-branding {
      margin-top: auto;
      display: flex;
      flex-direction: column;
      align-items: center;
      padding-top: 2rem;
      border-top: 1px solid rgba(59, 223, 180, 0.2);
    }
    
    .tracingpba-badge {
      display: inline-block;
      padding: 0.5rem 1rem;
      background: rgba(59, 223, 180, 0.1);
      border: 1px solid rgba(59, 223, 180, 0.3);
      border-radius: 4px;
      transition: all 0.3s ease;
    }
    
    .badge-text {
      font-family: 'Space Mono', monospace;
      font-size: 0.9rem;
      color: var(--tracingpba-teal);
      letter-spacing: 1px;
    }
    
    /* Estilos para navbar scrolled */
    .site-header.scrolled .header-background {
      background: rgba(10, 10, 30, 0.98);
    }
    
    .site-header.scrolled .main-navbar {
      height: 60px;
    }
    
    /* Menu link active state */
    .menu-link.active {
      color: var(--tracingpba-teal);
    }
    
    .menu-link.active .link-number {
      opacity: 1;
      color: var(--tracingpba-teal);
    }
    
    .menu-link.active::after {
      width: 60%;
      opacity: 1;
      box-shadow: 0 0 10px rgba(59, 223, 180, 0.5);
    }
    
    /* Media queries */
    @media (max-width: 992px) {
      .link-text {
        font-size: 0.85rem;
      }
      
      /* Ajustar anchos para tablets */
      .menu-item:nth-child(1) { width: 150px; }
      .menu-item:nth-child(2) { width: 90px; }
      .menu-item:nth-child(3) { width: 100px; }
      .menu-item:nth-child(4) { width: 90px; }
      .menu-item:nth-child(5) { width: 100px; }
    }
    
    @media (max-width: 768px) {
      .navbar-menu {
        display: none;
      }
      
      .menu-toggle {
        display: flex;
      }
      
      .mobile-menu {
        right: -100%;
      }
      
      .navbar-content {
        justify-content: space-between;
      }
      
      .main-navbar {
        height: 70px; /* Altura un poco menor en móviles */
      }
    }
    
    @media (max-width: 576px) {
      .mobile-menu {
        max-width: 100%;
      }
      
      .main-navbar {
        height: 60px;
      }
      
      .logo-transformia,
      .logo-product {
        font-size: 1rem;
      }
      
      .mobile-menu-link .link-text {
        font-size: 1rem;
      }
    }
  </style>
  
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Variables
      const header = document.getElementById('header');
      const menuToggle = document.getElementById('menu-toggle');
      const mobileMenu = document.getElementById('mobile-menu');
      const mobileMenuClose = document.getElementById('mobile-menu-close');
      const mobileMenuLinks = document.querySelectorAll('.mobile-menu-link');
      
      // Función para manejar el scroll
      function handleScroll() {
        if (header && window.scrollY > 10) {
          header.classList.add('scrolled');
        } else if (header) {
          header.classList.remove('scrolled');
        }
      }
      
      // Evento de scroll
      window.addEventListener('scroll', handleScroll);
      
      // Evento inicial para comprobar el estado del scroll
      handleScroll();
      
      // Funcionalidad del menú móvil
      if (menuToggle && mobileMenu) {
        menuToggle.addEventListener('click', () => {
          mobileMenu.classList.add('active');
          document.body.style.overflow = 'hidden'; // Evitar scroll en el body
        });
      }
      
      if (mobileMenuClose && mobileMenu) {
        mobileMenuClose.addEventListener('click', () => {
          mobileMenu.classList.remove('active');
          document.body.style.overflow = ''; // Restaurar scroll
        });
      }
      
      // Cerrar menú al hacer clic en un enlace
      mobileMenuLinks.forEach(link => {
        link.addEventListener('click', () => {
          if (mobileMenu) {
            mobileMenu.classList.remove('active');
            document.body.style.overflow = ''; // Restaurar scroll
          }
        });
      });
      
      // Cerrar menú al hacer clic fuera
      document.addEventListener('click', (e) => {
        if (mobileMenu && mobileMenu.classList.contains('active')) {
          const target = e.target as Node;
          const menuToggleElement = menuToggle as Node;
          
          if (!mobileMenu.contains(target) && 
              !menuToggleElement.contains(target)) {
            mobileMenu.classList.remove('active');
            document.body.style.overflow = ''; // Restaurar scroll
          }
        }
      });
      
      // Efecto de línea activa al hacer scroll
      const sections = document.querySelectorAll('section[id]');
      const menuLinks = document.querySelectorAll('.menu-link');
      
      function highlightCurrentSection() {
        const scrollY = window.scrollY;
        
        sections.forEach(section => {
          const sectionElement = section as HTMLElement;
          const sectionTop = sectionElement.offsetTop - 200;
          const sectionHeight = sectionElement.offsetHeight;
          const sectionId = section.getAttribute('id');
          
          if (scrollY > sectionTop && scrollY <= sectionTop + sectionHeight) {
            menuLinks.forEach(link => {
              link.classList.remove('active');
              if (link.getAttribute('href') === `#${sectionId}`) {
                link.classList.add('active');
              }
            });
          }
        });
      }
      
      window.addEventListener('scroll', highlightCurrentSection);
      
      // Inicializar el resaltado de la sección actual
      highlightCurrentSection();
    });
  </script>
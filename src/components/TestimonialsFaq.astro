---
// TestimonialsFaq.astro - Componente para las secciones de testimonios y preguntas frecuentes
---

<!-- Sección Testimonios -->
<section class="testimonials-section" id="testimonials">
    <div class="container">
      <h2 class="section-title animate-on-scroll">Testimonios & Métricas</h2>
      
      <div class="metrics-container animate-on-scroll">
        <div class="metric-counter">
          <div class="counter-value" data-value="8009">8,009+</div>
          <div class="counter-label">animales trazados</div>
        </div>
        
        <div class="metric-counter">
          <div class="counter-value" data-value="0">0</div>
          <div class="counter-label">hallazgos críticos en últimas 3 auditorías</div>
        </div>
        
        <div class="metric-counter">
          <div class="counter-value" data-value="99.95">99.95%</div>
          <div class="counter-label">uptime últimos 90 días</div>
        </div>
        
        <div class="metric-counter">
          <div class="counter-value" data-value="85">85%</div>
          <div class="counter-label">menos tiempo en procesamiento documental</div>
        </div>
      </div>
      
      <div class="testimonials-grid">
        <div class="testimonial-card animate-on-scroll">
          <div class="testimonial-quote">
            <p>"TracingPBA transformó completamente nuestros procesos. Pasamos de 4 horas a solo 30 minutos para completar los reportes de auditoría del INVIMA."</p>
          </div>
          <div class="testimonial-author">
            <div class="author-avatar">JC</div>
            <div class="author-info">
              <div class="author-name">Jorge Castillo</div>
              <div class="author-position">Jefe de Calidad</div>
              <div class="author-company">PBA Tauramena</div>
            </div>
          </div>
        </div>
        
        <div class="testimonial-card animate-on-scroll">
          <div class="testimonial-quote">
            <p>"El módulo de extracción de datos SINIGAN es oro puro. Eliminamos completamente los errores de transcripción manual y ahorramos el salario de un digitador."</p>
          </div>
          <div class="testimonial-author">
            <div class="author-avatar">MP</div>
            <div class="author-info">
              <div class="author-name">Mariana Pérez</div>
              <div class="author-position">Administradora</div>
              <div class="author-company">PBA Yopal</div>
            </div>
          </div>
        </div>
        
        <div class="testimonial-card animate-on-scroll">
          <div class="testimonial-quote">
            <p>"La impresión automática de precintos nos ha permitido aumentar nuestra capacidad de procesamiento en un 35% sin añadir personal adicional. Totalmente recomendado."</p>
          </div>
          <div class="testimonial-author">
            <div class="author-avatar">AL</div>
            <div class="author-info">
              <div class="author-name">Alberto López</div>
              <div class="author-position">Director Operativo</div>
              <div class="author-company">Frigoríficos del Valle</div>
            </div>
          </div>
        </div>
      </div>
      
      <div class="certifications-container animate-on-scroll">
        <div class="certification-label">Compatible con normativas:</div>
        <div class="certifications">
          <div class="certification-badge">INVIMA</div>
          <div class="certification-badge">ISO 9001</div>
          <div class="certification-badge">HACCP</div>
          <div class="certification-badge">BPM</div>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Sección FAQ -->
  <section class="faq-section" id="faq">
    <div class="container">
      <h2 class="section-title animate-on-scroll">Preguntas Frecuentes</h2>
      
      <div class="faq-container animate-on-scroll">
        <div class="faq-item">
          <div class="faq-question">
            <span class="question-text">¿Necesito internet continuo?</span>
            <span class="question-icon">+</span>
          </div>
          <div class="faq-answer">
            <p>No es necesario tener conexión permanente. TracingPBA opera en modo offline guardando las lecturas y sincronizando cuando la conexión se restablece. Sin embargo, para la extracción inicial de datos SINIGAN sí se requiere internet.</p>
          </div>
        </div>
        
        <div class="faq-item">
          <div class="faq-question">
            <span class="question-text">¿Funciona con mi impresora térmica?</span>
            <span class="question-icon">+</span>
          </div>
          <div class="faq-answer">
            <p>TracingPBA es compatible nativamente con las marcas más utilizadas en la industria: Zebra (ZT230, ZT411), SATO (CL4NX), TSC (TC-200) y más. Para otras marcas menos comunes, ofrecemos un servicio de integración personalizada.</p>
          </div>
        </div>
        
        <div class="faq-item">
          <div class="faq-question">
            <span class="question-text">¿Puedo integrarlo a mi ERP?</span>
            <span class="question-icon">+</span>
          </div>
          <div class="faq-answer">
            <p>Sí, TracingPBA ofrece una API REST completa y Webhooks para integración con sistemas ERP, contables y de gestión de inventario. Tenemos experiencia específica con SAP, Oracle y Microsoft Dynamics, pero podemos trabajar con cualquier sistema que admita integraciones estándar.</p>
          </div>
        </div>
        
        <div class="faq-item">
          <div class="faq-question">
            <span class="question-text">¿Cumple con el Decreto 1500 e INVIMA?</span>
            <span class="question-icon">+</span>
          </div>
          <div class="faq-answer">
            <p>Absolutamente. El sistema ha sido diseñado específicamente para cumplir con la normativa colombiana, incluyendo el Decreto 1500, las resoluciones del INVIMA y todos los requisitos de trazabilidad. Incluimos checklists de verificación y campos obligatorios para garantizar el cumplimiento normativo en todo momento.</p>
          </div>
        </div>
        
        <div class="faq-item">
          <div class="faq-question">
            <span class="question-text">¿Cómo se actualiza el roadmap?</span>
            <span class="question-icon">+</span>
          </div>
          <div class="faq-answer">
            <p>Nuestro roadmap se actualiza trimestralmente basado en dos factores principales: el feedback de clientes activos y los nuevos requisitos regulatorios. Realizamos sprints de desarrollo cada 3 meses y todos los clientes reciben actualizaciones automáticas sin costo adicional durante la vigencia de su contrato.</p>
          </div>
        </div>
        
        <div class="faq-item">
          <div class="faq-question">
            <span class="question-text">¿Qué soporte técnico ofrecen?</span>
            <span class="question-icon">+</span>
          </div>
          <div class="faq-answer">
            <p>Ofrecemos soporte técnico especializado en horario extendido (6am-10pm) todos los días mediante chat, correo y teléfono. Para clientes premium, contamos con soporte 24/7 y un tiempo de respuesta garantizado de máximo 30 minutos para incidencias críticas. Además, todas las implementaciones incluyen capacitación completa para el personal de planta.</p>
          </div>
        </div>
        
        <div class="faq-item">
          <div class="faq-question">
            <span class="question-text">¿Qué infraestructura necesito?</span>
            <span class="question-icon">+</span>
          </div>
          <div class="faq-answer">
            <p>TracingPBA es una solución cloud que requiere mínima infraestructura local. Necesitarás computadoras estándar con navegador web actualizado, impresoras térmicas compatibles y conexión a internet (puede ser intermitente). No se requieren servidores locales ni configuraciones complejas de red. También ofrecemos una opción de implementación on-premise para plantas con restricciones específicas.</p>
          </div>
        </div>
      </div>
      
      <div class="faq-cta animate-on-scroll">
        <p>¿No encuentras respuesta a tu pregunta?</p>
        <a href="#contacto" class="cybr-btn faq-button">
          Contáctanos
          <span class="cybr-btn__glitch"></span>
        </a>
      </div>
    </div>
  </section>
  
  <style>
    /* Estilos para Sección de Testimonios */
    .testimonials-section {
      background-color: var(--color-dark-blue);
      padding: 6rem 0;
      position: relative;
      overflow: hidden;
    }
    
    .testimonials-section::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image: 
        radial-gradient(circle at 25% 30%, rgba(79, 176, 110, 0.08) 0%, transparent 60%),
        radial-gradient(circle at 75% 70%, rgba(59, 223, 180, 0.08) 0%, transparent 60%);
      z-index: 1;
    }
    
    .section-title {
      font-family: var(--font-sans);
      font-size: 2.5rem;
      font-weight: 700;
      margin-bottom: 3rem;
      position: relative;
      color: white;
      z-index: 2;
      text-align: center;
    }
    
    /* Métricas */
    .metrics-container {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 1.5rem;
      margin-bottom: 4rem;
      position: relative;
      z-index: 2;
    }
    
    .metric-counter {
      background: rgba(10, 46, 54, 0.5);
      border-radius: 12px;
      border: 1px solid rgba(59, 223, 180, 0.2);
      padding: 2rem 1.5rem;
      text-align: center;
      transition: all 0.3s ease;
    }
    
    .metric-counter:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3), 0 0 15px rgba(59, 223, 180, 0.2);
      border-color: var(--tracingpba-teal);
    }
    
    .counter-value {
      font-family: var(--font-mono);
      font-size: 2.5rem;
      font-weight: bold;
      color: var(--tracingpba-teal);
      margin-bottom: 0.75rem;
      position: relative;
    }
    
    .counter-label {
      font-family: var(--font-mono);
      font-size: 0.9rem;
      color: rgba(255, 255, 255, 0.8);
      line-height: 1.4;
    }
    
    /* Testimonios */
    .testimonials-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 2rem;
      margin-bottom: 4rem;
      position: relative;
      z-index: 2;
    }
    
    .testimonial-card {
      background: rgba(10, 46, 54, 0.5);
      border-radius: 12px;
      border: 1px solid rgba(59, 223, 180, 0.2);
      padding: 2rem;
      transition: all 0.3s ease;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      height: 100%;
    }
    
    .testimonial-card:hover {
      transform: translateY(-5px);
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3), 0 0 15px rgba(59, 223, 180, 0.2);
      border-color: var(--tracingpba-teal);
    }
    
    .testimonial-quote {
      position: relative;
      padding-left: 1.5rem;
      margin-bottom: 2rem;
      flex-grow: 1;
    }
    
    .testimonial-quote::before {
      content: '"';
      position: absolute;
      top: -10px;
      left: -10px;
      font-size: 5rem;
      color: rgba(59, 223, 180, 0.2);
      font-family: Georgia, serif;
      line-height: 1;
    }
    
    .testimonial-quote p {
      font-size: 1.1rem;
      line-height: 1.6;
      color: rgba(255, 255, 255, 0.9);
      font-style: italic;
    }
    
    .testimonial-author {
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    
    .author-avatar {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      background-color: rgba(59, 223, 180, 0.1);
      color: var(--tracingpba-teal);
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-sans);
      font-weight: bold;
      font-size: 1.1rem;
      border: 1px solid rgba(59, 223, 180, 0.3);
    }
    
    .author-info {
      flex-grow: 1;
    }
    
    .author-name {
      font-family: var(--font-sans);
      font-size: 1rem;
      font-weight: bold;
      color: white;
      margin-bottom: 0.25rem;
    }
    
    .author-position {
      font-family: var(--font-sans);
      font-size: 0.9rem;
      color: rgba(255, 255, 255, 0.7);
      margin-bottom: 0.25rem;
    }
    
    .author-company {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: var(--tracingpba-teal);
    }
    
    /* Certificaciones */
    .certifications-container {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 1.5rem;
      position: relative;
      z-index: 2;
      padding: 2rem;
      background: rgba(10, 46, 54, 0.3);
      border-radius: 12px;
      border: 1px solid rgba(59, 223, 180, 0.1);
    }
    
    .certification-label {
      font-family: var(--font-mono);
      font-size: 1rem;
      color: rgba(255, 255, 255, 0.7);
    }
    
    .certifications {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
    }
    
    .certification-badge {
      padding: 0.5rem 1.25rem;
      background: rgba(59, 223, 180, 0.1);
      color: var(--tracingpba-teal);
      font-family: var(--font-mono);
      font-size: 0.9rem;
      font-weight: bold;
      border-radius: 50px;
      border: 1px solid rgba(59, 223, 180, 0.2);
      transition: all 0.3s ease;
    }
    
    .certification-badge:hover {
      background: rgba(59, 223, 180, 0.2);
      transform: translateY(-3px);
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2), 0 0 8px rgba(59, 223, 180, 0.3);
    }
    
    /* Estilos para Sección FAQ */
    .faq-section {
      background-color: var(--color-dark);
      padding: 6rem 0;
      position: relative;
    }
    
    .faq-section::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: radial-gradient(circle at 50% 50%, rgba(59, 223, 180, 0.05) 0%, transparent 70%);
      z-index: 1;
    }
    
    .faq-container {
      max-width: 800px;
      margin: 0 auto 4rem;
      position: relative;
      z-index: 2;
    }
    
    .faq-item {
      border-bottom: 1px solid rgba(59, 223, 180, 0.1);
      transition: all 0.3s ease;
    }
    
    .faq-item:hover {
      border-color: rgba(59, 223, 180, 0.3);
    }
    
    .faq-question {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 1.5rem 0;
      cursor: pointer;
      transition: all 0.3s ease;
    }
    
    .question-text {
      font-family: var(--font-sans);
      font-size: 1.25rem;
      font-weight: 600;
      color: white;
    }
    
    .question-icon {
      font-family: var(--font-mono);
      font-size: 1.5rem;
      color: var(--tracingpba-teal);
      transition: all 0.3s ease;
      width: 24px;
      height: 24px;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    
    .faq-answer {
      max-height: 0;
      overflow: hidden;
      transition: all 0.3s ease;
      opacity: 0;
      padding: 0 1rem 0 0;
    }
    
    .faq-item.active .faq-answer {
      max-height: 500px;
      opacity: 1;
      padding-bottom: 1.5rem;
    }
    
    .faq-item.active .question-icon {
      transform: rotate(45deg);
    }
    
    .faq-answer p {
      color: rgba(255, 255, 255, 0.8);
      font-size: 1.1rem;
      line-height: 1.6;
    }
    
    .faq-cta {
      text-align: center;
      position: relative;
      z-index: 2;
    }
    
    .faq-cta p {
      font-size: 1.1rem;
      color: rgba(255, 255, 255, 0.8);
      margin-bottom: 1.5rem;
    }
    
    .faq-button, 
    .testimonial-button {
      display: inline-block;
    }
    
    /* Animaciones de contador */
    @keyframes count-up {
      from {
        content: "0";
      }
      to {
        content: attr(data-value);
      }
    }
    
    /* Responsive */
    @media (max-width: 992px) {
      .section-title {
        font-size: 2.2rem;
      }
      
      .testimonials-grid {
        grid-template-columns: 1fr;
      }
      
      .certifications-container {
        flex-direction: column;
        align-items: center;
        text-align: center;
      }
    }
    
    @media (max-width: 768px) {
      .section-title {
        font-size: 2rem;
      }
      
      .metrics-container {
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      }
      
      .counter-value {
        font-size: 2rem;
      }
      
      .counter-label {
        font-size: 0.8rem;
      }
      
      .testimonial-card {
        padding: 1.5rem;
      }
      
      .testimonial-quote p {
        font-size: 1rem;
      }
      
      .question-text {
        font-size: 1.1rem;
      }
    }
    
    @media (max-width: 576px) {
      .section-title {
        font-size: 1.8rem;
      }
      
      .metrics-container {
        grid-template-columns: 1fr 1fr;
      }
      
      .counter-value {
        font-size: 1.8rem;
      }
      
      .question-text {
        font-size: 1rem;
        padding-right: 1rem;
      }
    }
  </style>
  
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      // FAQ Acordeón
      const faqItems = document.querySelectorAll('.faq-question');
      faqItems.forEach(item => {
        item.addEventListener('click', () => {
          const parent = item.parentElement;
          
          // Cerrar todos los otros items
          document.querySelectorAll('.faq-item').forEach(faqItem => {
            if (faqItem !== parent && faqItem.classList.contains('active')) {
              faqItem.classList.remove('active');
              faqItem.querySelector('.question-icon').textContent = '+';
            }
          });
          
          // Abrir/cerrar el item actual
          parent.classList.toggle('active');
          
          // Actualizar el icono
          const icon = item.querySelector('.question-icon');
          icon.textContent = parent.classList.contains('active') ? '×' : '+';
        });
      });
      
      // Animación de contadores
      const animateCounters = () => {
        const counters = document.querySelectorAll('.counter-value');
        
        counters.forEach(counter => {
          const target = parseFloat(counter.getAttribute('data-value'));
          
          // Determinar si es entero o decimal
          const isDecimal = target % 1 !== 0;
          
          // Configurar la animación
          let startValue = 0;
          const duration = 2000; // ms
          const increment = target / (duration / 16); // 60 fps
          
          // Función de animación
          function updateCount() {
            startValue += increment;
            
            if (startValue >= target) {
              startValue = target;
            }
            
            // Formatear el valor según sea decimal o entero
            let formattedValue;
            
            if (isDecimal) {
              formattedValue = startValue.toFixed(2);
            } else {
              formattedValue = Math.floor(startValue).toLocaleString();
            }
            
            // Agregar el símbolo "+" si estaba en el original
            if (counter.textContent.includes('+')) {
              formattedValue += '+';
            }
            
            // Agregar el símbolo "%" si estaba en el original
            if (counter.textContent.includes('%')) {
              formattedValue += '%';
            }
            
            counter.textContent = formattedValue;
            
            if (startValue < target) {
              requestAnimationFrame(updateCount);
            }
          }
          
          // Iniciar la animación
          updateCount();
        });
      };
      
      // Observer para iniciar la animación cuando los contadores sean visibles
      const observer = new IntersectionObserver((entries) => {
        entries.forEach(entry => {
          if (entry.isIntersecting) {
            animateCounters();
            observer.unobserve(entry.target);
          }
        });
      }, { threshold: 0.1 });
      
      // Observar el contenedor de métricas
      const metricsContainer = document.querySelector('.metrics-container');
      if (metricsContainer) {
        observer.observe(metricsContainer);
      }
    });
  </script>
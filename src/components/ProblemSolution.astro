  <style>
    /* Estilos principales */
    .problem-solution-section {
      padding: 120px 0;
      background-color: var(--color-dark);
      position: relative;
      overflow: hidden;
    }
    
    .problem-solution-section::before {
      content: '';
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image: 
        linear-gradient(to right, rgba(66, 255, 209, 0.03) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(66, 255, 209, 0.03) 1px, transparent 1px);
      background-size: 30px 30px;
      z-index: 1;
      pointer-events: none;
    }
    
    .container {
      position: relative;
      z-index: 5;
      width: 90%;
      max-width: 1200px;
      margin: 0 auto;
    }
    
    .section-header {
      text-align: center;
      margin-bottom: 60px;
    }
    
    .section-title {
      font-size: 2.8rem;
      font-weight: 800;
      margin-bottom: 1rem;
      background: linear-gradient(90deg, #ffffff, var(--tracingpba-teal));
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      color: transparent;
    }
    
    .section-subtitle {
      font-size: 1.2rem;
      color: rgba(255, 255, 255, 0.7);
      max-width: 700px;
      margin: 0 auto;
    }
    
    /* Contenedor de pares problema-solución */
    .problem-solution-container {
      display: flex;
      flex-direction: column;
      gap: 60px;
      margin-bottom: 80px;
    }
    
    .problem-solution-pair {
      display: flex;
      align-items: stretch;
      gap: 0;
    }
    
    .problem-card, .solution-card {
      flex: 1;
      background: rgba(26, 26, 64, 0.6);
      border-radius: 12px;
      padding: 25px;
      display: flex;
      flex-direction: column;
      transition: all 0.3s ease;
      position: relative;
      z-index: 5;
    }
    
    .problem-card {
      background: linear-gradient(145deg, rgba(26, 26, 64, 0.8), rgba(10, 46, 54, 0.8));
      border: 1px solid rgba(255, 66, 114, 0.2);
      border-radius: 12px 0 0 12px;
      box-shadow: -5px 5px 15px rgba(0, 0, 0, 0.2);
    }
    
    .solution-card {
      background: linear-gradient(145deg, rgba(10, 46, 54, 0.8), rgba(26, 26, 64, 0.8));
      border: 1px solid rgba(66, 255, 209, 0.2);
      border-radius: 0 12px 12px 0;
      box-shadow: 5px 5px 15px rgba(0, 0, 0, 0.2);
    }
    
    .problem-card:hover, .solution-card:hover {
      transform: translateY(-5px);
    }
    
    /* Conector entre problema y solución */
    .connector {
      width: 80px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      z-index: 1;
      overflow: hidden;
    }
    
    .arrow {
      width: 100%;
      height: 2px;
      position: relative;
    }
    
    .arrow-stem {
      width: 100%;
      height: 2px;
      background: var(--tracingpba-teal);
      position: relative;
      opacity: 0.7;
      
      /* Línea punteada animada */
      background-image: linear-gradient(
        to right,
        var(--tracingpba-teal) 50%,
        transparent 50%
      );
      background-size: 12px 2px;
      animation: moveDash 20s linear infinite;
    }
    
    .arrow-head {
      position: absolute;
      right: 0;
      top: 50%;
      transform: translateY(-50%);
      width: 0;
      height: 0;
      border-top: 6px solid transparent;
      border-bottom: 6px solid transparent;
      border-left: 8px solid var(--tracingpba-teal);
    }
    
    @keyframes moveDash {
      to {
        background-position: 1000px 0;
      }
    }
    
    /* Estilos de las tarjetas */
    .card-icon {
      width: 50px;
      height: 50px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      margin-bottom: 20px;
    }
    
    .problem-icon {
      background: rgba(255, 66, 114, 0.1);
      border: 1px solid rgba(255, 66, 114, 0.3);
      color: rgba(255, 66, 114, 0.9);
    }
    
    .solution-icon {
      background: rgba(66, 255, 209, 0.1);
      border: 1px solid rgba(66, 255, 209, 0.3);
      color: rgba(66, 255, 209, 0.9);
    }
    
    .card-title {
      font-size: 1.3rem;
      color: white;
      margin-bottom: 20px;
      font-weight: 600;
      line-height: 1.3;
    }
    
    .card-content {
      display: flex;
      flex-direction: column;
      flex-grow: 1;
    }
    
    .problem-point, .solution-point {
      display: flex;
      align-items: flex-start;
      margin-bottom: 15px;
    }
    
    .problem-bullet {
      min-width: 8px;
      height: 8px;

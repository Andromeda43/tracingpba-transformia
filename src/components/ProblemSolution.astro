<!-- ProblemSolution.astro - Componente con problemas y soluciones lado a lado -->

<section class="problem-solution-section" id="problem-solution">
    <div class="container">
      <div class="section-header">
        <h2 class="section-title">Del Problema a la Solución</h2>
        <p class="section-subtitle">Transformando los desafíos diarios de las plantas de beneficio en procesos eficientes</p>
      </div>
      
      <!-- Contenedor para pares de problema-solución -->
      <div class="problem-solution-container">
        
        <!-- Par 1: Trazabilidad -->
        <div class="problem-solution-pair">
          <div class="problem-card">
            <div class="card-icon problem-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 0 0 2.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 0 0 1.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 0 0-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 0 0-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 0 0-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 0 0-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 0 0 1.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
                <circle cx="12" cy="12" r="3"></circle>
              </svg>
            </div>
            <h3 class="card-title">Trazabilidad Manual y Fragmentada</h3>
            <div class="card-content">
              <div class="problem-point">
                <span class="problem-bullet"></span>
                <p>Registro manual de datos en múltiples formatos y sistemas</p>
              </div>
              <div class="problem-point">
                <span class="problem-bullet"></span>
                <p>Dificultad para rastrear el origen y destino de cada animal</p>
              </div>
              <div class="problem-point">
                <span class="problem-bullet"></span>
                <p>Imposible acceder a información histórica de forma rápida</p>
              </div>
              <div class="illustration">
                <div class="system-node">SINIGAN</div>
                <div class="system-node">Excel</div>
                <div class="system-node">Papel</div>
              </div>
            </div>
          </div>
          
          <div class="connector">
            <div class="arrow">
              <div class="arrow-stem"></div>
              <div class="arrow-head"></div>
            </div>
          </div>
          
          <div class="solution-card">
            <div class="card-icon solution-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
              </svg>
            </div>
            <h3 class="card-title">Trazabilidad 360° Integrada</h3>
            <div class="card-content">
              <div class="solution-point">
                <span class="solution-check">✓</span>
                <p>Sistema unificado con integración automática a SINIGAN</p>
              </div>
              <div class="solution-point">
                <span class="solution-check">✓</span>
                <p>Control de toda la cadena con checkpoints digitales</p>
              </div>
              <div class="solution-point">
                <span class="solution-check">✓</span>
                <p>Histórico completo disponible al instante</p>

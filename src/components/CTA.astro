---
// CTA.astro - Componente para la sección de Call to Action (Contacto) en TracingPBA
---

<section class="cta-section" id="contacto">
    <div class="container">
      <div class="cta-content animate-on-scroll">
        <h2 class="cta-title">¿Listo para transformar tu trazabilidad?</h2>
        
        <div class="cta-card">
          <div class="cta-card-decoration">
            <div class="decoration-circle"></div>
            <div class="decoration-line"></div>
            <div class="decoration-dots">
              <div class="dot"></div>
              <div class="dot"></div>
              <div class="dot"></div>
            </div>
          </div>
          
          <form class="cta-form" id="contact-form">
            <div class="form-grid">
              <div class="form-group">
                <label for="nombre">Nombre</label>
                <input type="text" id="nombre" name="nombre" placeholder="Tu nombre completo" required>
              </div>
              
              <div class="form-group">
                <label for="email">Correo corporativo</label>
                <input type="email" id="email" name="email" placeholder="tu@empresa.com" required>
              </div>
              
              <div class="form-group">
                <label for="telefono">Teléfono</label>
                <input type="tel" id="telefono" name="telefono" placeholder="+57 300 000 0000" required>
              </div>
              
              <div class="form-group">
                <label for="planta">Planta / NIT</label>
                <input type="text" id="planta" name="planta" placeholder="Nombre de la planta o NIT" required>
              </div>
            </div>
            
            <div class="form-group">
              <label for="mensaje">¿Qué te interesa más de TracingPBA?</label>
              <textarea id="mensaje" name="mensaje" rows="3" placeholder="Cuéntanos qué módulos te interesan o si tienes alguna necesidad específica..."></textarea>
            </div>
            
            <div class="form-options">
              <div class="form-checkbox">
                <input type="checkbox" id="demo" name="intereses" value="demo">
                <label for="demo">Quiero una demo</label>
              </div>
              <div class="form-checkbox">
                <input type="checkbox" id="cotizacion" name="intereses" value="cotizacion">
                <label for="cotizacion">Necesito una cotización</label>
              </div>
              <div class="form-checkbox">
                <input type="checkbox" id="presentacion" name="intereses" value="presentacion">
                <label for="presentacion">Solicito una presentación</label>
              </div>
            </div>
            
            <p class="form-disclaimer">Respondemos en menos de 24 h. Sin compromiso.</p>
            
            <div class="form-actions">
              <button type="submit" class="cybr-btn cta-button" id="submit-button">
                Solicitar información
                <span class="cybr-btn__glitch"></span>
              </button>
            </div>
          </form>
        </div>
        
        <div class="form-success" id="form-success">
          <div class="success-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path>
              <polyline points="22 4 12 14.01 9 11.01"></polyline>
            </svg>
          </div>
          <h3 class="success-title">¡Solicitud enviada con éxito!</h3>
          <p class="success-message">
            Gracias por tu interés en TracingPBA. Nuestro equipo te contactará dentro de las próximas 24 horas para brindarte toda la información que necesitas.
          </p>
          <div class="success-details">
            <p>Mientras tanto, puedes revisar nuestra ficha técnica o explorar más sobre nuestra empresa:</p>
            <div class="success-links">
              <a href="#" class="success-link">Descargar ficha técnica</a>
              <a href="https://transformia.dev" class="success-link">Conocer más sobre Transformia</a>
            </div>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Elementos decorativos -->
    <div class="cta-decoration">
      <div class="tech-decorations">
        <div class="corner-element top-right"></div>
        <div class="corner-element bottom-left"></div>
        
        <div class="data-node" style="--top: 15%; --left: 5%;"></div>
        <div class="data-node" style="--top: 80%; --left: 8%;"></div>
        <div class="data-node" style="--top: 20%; --left: 95%;"></div>
        <div class="data-node" style="--top: 70%; --left: 92%;"></div>
      </div>
      
      <div class="grid-lines"></div>
      <div class="radial-glow"></div>
    </div>
  </section>
  
  <style>
    /* Estilos específicos para el componente CTA */
    .cta-section {
      background-color: var(--tracingpba-dark);
      padding: 6rem 0;
      position: relative;
      overflow: hidden;
    }
    
    .cta-content {
      max-width: 800px;
      margin: 0 auto;
      position: relative;
      z-index: 2;
      text-align: center;
    }
    
    .cta-title {
      font-family: var(--font-sans);
      font-size: 2.5rem;
      font-weight: 700;
      color: white;
      margin-bottom: 2.5rem;
      text-shadow: 0 0 10px rgba(66, 255, 209, 0.3);
    }
    
    .cta-card {
      background: rgba(26, 26, 64, 0.6);
      backdrop-filter: blur(10px);
      border-radius: 12px;
      border: 1px solid rgba(66, 255, 209, 0.3);
      padding: 2.5rem;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3), 0 0 30px rgba(66, 255, 209, 0.2);
      position: relative;
      overflow: hidden;
    }
    
    .cta-card-decoration {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      pointer-events: none;
      overflow: hidden;
      z-index: 1;
    }
    
    .decoration-circle {
      position: absolute;
      top: -100px;
      right: -100px;
      width: 200px;
      height: 200px;
      border-radius: 50%;
      border: 2px dashed rgba(66, 255, 209, 0.3);
      opacity: 0.4;
    }
    
    .decoration-line {
      position: absolute;
      bottom: 20px;
      left: 0;
      width: 100%;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(66, 255, 209, 0.3), transparent);
    }
    
    .decoration-dots {
      position: absolute;
      bottom: 40px;
      left: 30px;
      display: flex;
      gap: 8px;
    }
    
    .dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background-color: var(--tracingpba-teal);
      opacity: 0.5;
      animation: pulse-dot 3s infinite alternate;
    }
    
    .dot:nth-child(2) {
      animation-delay: 0.5s;
    }
    
    .dot:nth-child(3) {
      animation-delay: 1s;
    }
    
    @keyframes pulse-dot {
      0% {
        transform: scale(1);
        opacity: 0.5;
      }
      100% {
        transform: scale(1.5);
        opacity: 1;
      }
    }
    
    .cta-form {
      position: relative;
      z-index: 2;
      text-align: left;
    }
    
    .form-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
      gap: 1.5rem;
      margin-bottom: 1.5rem;
    }
    
    .form-group {
      margin-bottom: 1.5rem;
    }
    
    .form-group label {
      display: block;
      font-family: var(--font-mono);
      font-size: 0.9rem;
      color: rgba(255, 255, 255, 0.7);
      margin-bottom: 0.5rem;
    }
    
    .form-group input,
    .form-group textarea {
      width: 100%;
      padding: 0.75rem 1rem;
      background: rgba(20, 20, 40, 0.6);
      border: 1px solid rgba(66, 255, 209, 0.3);
      border-radius: 4px;
      color: white;
      font-family: var(--font-sans);
      transition: all 0.3s ease;
    }
    
    .form-group textarea {
      resize: vertical;
      min-height: 100px;
    }
    
    .form-group input:focus,
    .form-group textarea:focus {
      outline: none;
      border-color: var(--tracingpba-teal);
      box-shadow: 0 0 10px rgba(66, 255, 209, 0.5);
    }
    
    .form-group input::placeholder,
    .form-group textarea::placeholder {
      color: rgba(255, 255, 255, 0.4);
    }
    
    .form-options {
      display: flex;
      flex-wrap: wrap;
      gap: 1.5rem;
      margin-bottom: 1.5rem;
    }
    
    .form-checkbox {
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }
    
    .form-checkbox input[type="checkbox"] {
      width: 18px;
      height: 18px;
      appearance: none;
      -webkit-appearance: none;
      -moz-appearance: none;
      background: rgba(20, 20, 40, 0.6);
      border: 1px solid rgba(66, 255, 209, 0.3);
      border-radius: 3px;
      position: relative;
      cursor: pointer;
      transition: all 0.3s ease;
    }
    
    .form-checkbox input[type="checkbox"]:checked {
      background-color: var(--tracingpba-teal);
      border-color: var(--tracingpba-teal);
    }
    
    .form-checkbox input[type="checkbox"]:checked::after {
      content: '';
      position: absolute;
      top: 2px;
      left: 6px;
      width: 5px;
      height: 10px;
      border: solid var(--tracingpba-dark);
      border-width: 0 2px 2px 0;
      transform: rotate(45deg);
    }
    
    .form-checkbox label {
      font-family: var(--font-sans);
      font-size: 0.9rem;
      color: rgba(255, 255, 255, 0.8);
      cursor: pointer;
    }
    
    .form-disclaimer {
      font-family: var(--font-mono);
      font-size: 0.9rem;
      color: rgba(255, 255, 255, 0.6);
      margin-bottom: 2rem;
      text-align: center;
    }
    
    .form-actions {
      display: flex;
      justify-content: center;
    }
    
    .cta-button {
      font-size: 1.1rem;
      padding: 1rem 2.5rem;
    }
    
    /* Mensaje de éxito */
    .form-success {
      background: rgba(26, 26, 64, 0.6);
      backdrop-filter: blur(10px);
      border-radius: 12px;
      border: 1px solid rgba(66, 255, 209, 0.3);
      padding: 2.5rem;
      box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3), 0 0 30px rgba(66, 255, 209, 0.2);
      text-align: center;
      display: none;
    }
    
    .form-success.visible {
      display: block;
      animation: fadeIn 0.5s ease forwards;
    }
    
    @keyframes fadeIn {
      from {
        opacity: 0;
        transform: translateY(20px);
      }
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }
    
    .success-icon {
      color: var(--tracingpba-teal);
      margin-bottom: 1.5rem;
      animation: success-pulse 2s infinite alternate;
    }
    
    @keyframes success-pulse {
      0% {
        transform: scale(1);
        filter: drop-shadow(0 0 3px rgba(66, 255, 209, 0.5));
      }
      100% {
        transform: scale(1.1);
        filter: drop-shadow(0 0 8px rgba(66, 255, 209, 0.8));
      }
    }
    
    .success-title {
      font-family: var(--font-sans);
      font-size: 1.8rem;
      color: white;
      margin-bottom: 1rem;
    }
    
    .success-message {
      font-size: 1.1rem;
      color: rgba(255, 255, 255, 0.8);
      margin-bottom: 2rem;
      max-width: 600px;
      margin-left: auto;
      margin-right: auto;
    }
    
    .success-details {
      background: rgba(20, 20, 40, 0.6);
      padding: 1.5rem;
      border-radius: 6px;
      margin-top: 2rem;
    }
    
    .success-links {
      display: flex;
      justify-content: center;
      flex-wrap: wrap;
      gap: 1rem;
      margin-top: 1rem;
    }
    
    .success-link {
      display: inline-block;
      padding: 0.75rem 1.5rem;
      background: rgba(66, 255, 209, 0.1);
      border: 1px solid rgba(66, 255, 209, 0.3);
      border-radius: 4px;
      color: var(--tracingpba-teal);
      font-family: var(--font-mono);
      font-size: 0.9rem;
      text-decoration: none;
      transition: all 0.3s ease;
    }
    
    .success-link:hover {
      background: rgba(66, 255, 209, 0.2);
      transform: translateY(-3px);
      box-shadow: 0 5px 15px rgba(0, 0, 0, 0.2), 0 0 10px rgba(66, 255, 209, 0.3);
    }
    
    /* Elementos decorativos */
    .cta-decoration {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
    }
    
    .tech-decorations {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
      pointer-events: none;
    }
    
    .corner-element {
      position: absolute;
      width: 100px;
      height: 100px;
      opacity: 0.6;
    }
    
    .corner-element::before,
    .corner-element::after {
      content: '';
      position: absolute;
      background-color: var(--tracingpba-teal);
    }
    
    .corner-element::before {
      width: 100%;
      height: 2px;
      box-shadow: 0 0 10px var(--tracingpba-teal);
    }
    
    .corner-element::after {
      width: 2px;
      height: 100%;
      box-shadow: 0 0 10px var(--tracingpba-teal);
    }
    
    .corner-element.top-right {
      top: 30px;
      right: 30px;
    }
    
    .corner-element.top-right::before {
      top: 0;
      right: 0;
    }
    
    .corner-element.top-right::after {
      top: 0;
      right: 0;
    }
    
    .corner-element.bottom-left {
      bottom: 30px;
      left: 30px;
    }
    
    .corner-element.bottom-left::before {
      bottom: 0;
      left: 0;
    }
    
    .corner-element.bottom-left::after {
      bottom: 0;
      left: 0;
    }
    
    .data-node {
      position: absolute;
      top: var(--top);
      left: var(--left);
      width: 6px;
      height: 6px;
      background-color: var(--tracingpba-teal);
      border-radius: 50%;
      box-shadow: 0 0 10px var(--tracingpba-teal);
      animation: data-node-pulse 3s infinite alternate;
    }
    
    @keyframes data-node-pulse {
      0% {
        opacity: 0.5;
        transform: scale(1);
      }
      100% {
        opacity: 1;
        transform: scale(1.5);
      }
    }
    
    .grid-lines {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image: 
        linear-gradient(to right, rgba(66, 255, 209, 0.1) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(66, 255, 209, 0.1) 1px, transparent 1px);
      background-size: 30px 30px;
      opacity: 0.4;
      z-index: 1;
    }
    
    .radial-glow {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: radial-gradient(ellipse at center, rgba(66, 255, 209, 0.15) 0%, transparent 70%);
      z-index: 2;
    }
    
    /* Media Queries */
    @media (max-width: 992px) {
      .cta-title {
        font-size: 2.2rem;
      }
      
      .form-options {
        flex-direction: column;
        gap: 1rem;
      }
    }
    
    @media (max-width: 768px) {
      .cta-title {
        font-size: 2rem;
      }
      
      .cta-card {
        padding: 2rem;
      }
      
      .corner-element {
        width: 60px;
        height: 60px;
      }
    }
    
    @media (max-width: 576px) {
      .cta-title {
        font-size: 1.8rem;
      }
      
      .cta-card {
        padding: 1.5rem;
      }
      
      .corner-element {
        width: 40px;
        height: 40px;
      }
      
      .success-title {
        font-size: 1.5rem;
      }
      
      .success-message {
        font-size: 1rem;
      }
    }
  </style>
  
  <script>
    document.addEventListener('DOMContentLoaded', function() {
      const contactForm = document.getElementById('contact-form');
      const formSuccess = document.getElementById('form-success');
      const submitButton = document.getElementById('submit-button');
      
      if (contactForm) {
        contactForm.addEventListener('submit', function(e) {
          e.preventDefault();
          
          // Cambiar estado del botón a "Enviando..."
          if (submitButton) {
            submitButton.disabled = true;
            submitButton.textContent = 'Enviando...';
          }
          
          // Simulación de envío (en producción, aquí se conectaría con backend)
          setTimeout(() => {
            // Ocultar formulario
            contactForm.style.display = 'none';
            
            // Mostrar mensaje de éxito
            if (formSuccess) {
              formSuccess.classList.add('visible');
            }
            
            // Reiniciar formulario para futuros envíos
            contactForm.reset();
            
            // Restablecer estado del botón
            if (submitButton) {
              submitButton.disabled = false;
              submitButton.textContent = 'Solicitar información';
            }
            
            // Scroll hacia el mensaje de éxito
            if (formSuccess) {
              formSuccess.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
          }, 2000);
        });
      }
    });
  </script>
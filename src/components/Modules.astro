<!-- Script sin errores de TypeScript -->
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const track = document.querySelector('.carousel-track');
    const slides = document.querySelectorAll('.carousel-slide');
    const prevButton = document.querySelector('.prev-slide');
    const nextButton = document.querySelector('.next-slide');
    const indicators = document.querySelectorAll('.indicator');
    const carouselContainer = document.querySelector('.carousel-container');
    
    let currentIndex = 0;
    const slideCount = slides.length;
    
    // Función para actualizar la posición del carrusel
    function updateCarousel(indexValue) {
      if (track instanceof HTMLElement) {
        track.style.transform = `translateX(-${indexValue * 100}%)`;
      }
      
      // Actualizar el estado de los indicadores
      indicators.forEach(function(indicator, i) {
        if (i === indexValue) {
          indicator.classList.add('active');
        } else {
          indicator.classList.remove('active');
        }
      });
      
      // Reproducir el video actual y pausar los demás
      slides.forEach(function(slide, i) {
        const video = slide.querySelector('video');
        if (video) {
          if (i === indexValue) {
            // Usamos un timeout para asegurar que el video se reproduce solo después de que la transición termine
            setTimeout(function() {
              video.play().catch(function(e) {
                console.log("Autoplay prevented:", e);
              });
            }, 500);
          } else {
            video.pause();
            // Reiniciar el video para que comience desde el principio la próxima vez
            video.currentTime = 0;
          }
        }
      });
      
      // Actualizar el índice actual
      currentIndex = indexValue;
    }
    
    // Manejar clic en el botón anterior
    if (prevButton) {
      prevButton.addEventListener('click', function() {
        const newIndex = (currentIndex - 1 + slideCount) % slideCount;
        updateCarousel(newIndex);
      });
    }
    
    // Manejar clic en el botón siguiente
    if (nextButton) {
      nextButton.addEventListener('click', function() {
        const newIndex = (currentIndex + 1) % slideCount;
        updateCarousel(newIndex);
      });
    }
    
    // Manejar clic en los indicadores
    indicators.forEach(function(indicator, idx) {
      indicator.addEventListener('click', function() {
        updateCarousel(idx);
      });
    });
    
    // Carga progresiva de videos para mejor rendimiento
    function lazyLoadVideos() {
      slides.forEach(function(slide, i) {
        const video = slide.querySelector('video');
        if (video && i !== currentIndex) {
          // Solo cargamos los videos vecinos para mejor rendimiento
          if (Math.abs(i - currentIndex) <= 1 || i === 0 || i === slideCount - 1) {
            const source = video.querySelector('source');
            if (source) {
              const dataSrc = source.getAttribute('src');
              if (dataSrc) {
                source.setAttribute('src', dataSrc);
                video.load();
              }
            }
          }
        }
      });
    }
    
    // Habilitar gestos de deslizamiento (swipe) para dispositivos táctiles
    let touchStartX = 0;
    let touchEndX = 0;
    
    if (carouselContainer) {
      carouselContainer.addEventListener('touchstart', function(event) {
        if (event instanceof TouchEvent && event.changedTouches && event.changedTouches.length > 0) {
          touchStartX = event.changedTouches[0].screenX;
        }
      }, {passive: true});
      
      carouselContainer.addEventListener('touchend', function(event) {
        if (event instanceof TouchEvent && event.changedTouches && event.changedTouches.length > 0) {
          touchEndX = event.changedTouches[0].screenX;
          handleSwipe();
        }
      }, {passive: true});
    }
    
    function handleSwipe() {
      const minSwipeDistance = 30;
      
      if (touchEndX < touchStartX - minSwipeDistance) {
        // Deslizar a la izquierda (siguiente)
        const newIndex = (currentIndex + 1) % slideCount;
        updateCarousel(newIndex);
      }
      
      if (touchEndX > touchStartX + minSwipeDistance) {
        // Deslizar a la derecha (anterior)
        const newIndex = (currentIndex - 1 + slideCount) % slideCount;
        updateCarousel(newIndex);
      }
    }
    
    // Ajustar la altura del contenedor en móviles para evitar desbordamiento
    function adjustHeight() {
      if (window.innerWidth <= 768) {
        slides.forEach(function(slide) {
          const content = slide.querySelector('.slide-content');
          if (content && content instanceof HTMLElement) {
            content.style.minHeight = 'auto';
          }
        });
      }
    }
    
    // Inicializar el primer slide
    updateCarousel(0);
    lazyLoadVideos();
    
    // Ajustar al cargar y al cambiar el tamaño de la ventana
    adjustHeight();
    window.addEventListener('resize', adjustHeight);
  });
</script>
  <style>
    /* Estilos del hero rediseñado */
    .hero-section {
      min-height: 100vh;
      display: flex;
      align-items: center;
      position: relative;
      background-color: #0a0a24; /* Color más oscuro para mayor contraste */
      overflow: hidden;
      padding: 6rem 0;
    }
    
    .hero-content {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
      position: relative;
      z-index: 5;
    }
    
    /* Fondo y elementos decorativos */
    .hero-bg {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      z-index: 1;
    }
    
    .bg-grid {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background-image: 
        linear-gradient(to right, rgba(66, 255, 209, 0.08) 1px, transparent 1px),
        linear-gradient(to bottom, rgba(66, 255, 209, 0.08) 1px, transparent 1px);
      background-size: 30px 30px;
      opacity: 0.3;
    }
    
    .bg-glow {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      background: radial-gradient(circle at center, rgba(59, 223, 180, 0.15) 0%, transparent 70%);
      z-index: 1;
    }
    
    .bg-circle {
      position: absolute;
      border-radius: 50%;
      filter: blur(80px);
      z-index: 1;
    }
    
    .bg-circle.one {
      width: 600px;
      height: 600px;
      background: rgba(66, 255, 209, 0.15);
      top: -200px;
      left: -200px;
      animation: float-slow 15s infinite alternate ease-in-out;
    }
    
    .bg-circle.two {
      width: 400px;
      height: 400px;
      background: rgba(66, 135, 255, 0.1);
      bottom: -100px;
      right: -100px;
      animation: float-slow 18s infinite alternate-reverse ease-in-out;
    }
    
    .bg-circle.three {
      width: 300px;
      height: 300px;
      background: rgba(176, 66, 255, 0.1);
      bottom: 30%;
      left: 20%;
      animation: float-slow 20s infinite alternate ease-in-out;
    }
    
    @keyframes float-slow {
      0% {
        transform: translate(0, 0);
      }
      100% {
        transform: translate(50px, 30px);
      }
    }
    
    /* Sección de texto */
    .hero-text {
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    
    .hero-badge {
      display: inline-flex;
      align-items: center;
      background: rgba(66, 255, 209, 0.1);
      border: 1px solid rgba(66, 255, 209, 0.3);
      border-radius: 50px;
      padding: 0.5rem 1rem;
      margin-bottom: 1.5rem;
      width: fit-content;
    }
    
    .badge-icon {
      color: #42FFD1;
      margin-right: 0.5rem;
      display: flex;
      align-items: center;
    }
    
    .badge-text {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 1px;
      color: #42FFD1;
    }
    
    .hero-title {
      font-family: var(--font-sans);
      font-size: 3.5rem;
      line-height: 1.2;
      font-weight: 700;
      margin-bottom: 1.5rem;
      color: white;
      letter-spacing: -0.01em;
    }
    
    .hero-accent {
      background: linear-gradient(90deg, #42FFD1, #4FB06E);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
      color: transparent;
      position: relative;
      display: inline-block;
    }
    
    .hero-accent::after {
      content: '';
      position: absolute;
      bottom: 5px;
      left: 0;
      width: 100%;
      height: 4px;
      background: linear-gradient(90deg, #42FFD1, #4FB06E);
      border-radius: 2px;
      opacity: 0.6;
    }
    
    .hero-description {
      font-size: 1.25rem;
      line-height: 1.6;
      color: rgba(255, 255, 255, 0.9);
      margin-bottom: 2rem;
      max-width: 550px;
    }
    
    .hero-features {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      margin-bottom: 2.5rem;
    }
    
    .feature-item {
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    
    .feature-icon {
      width: 38px;
      height: 38px;
      border-radius: 50%;
      background: rgba(66, 255, 209, 0.1);
      display: flex;
      align-items: center;
      justify-content: center;
      color: #42FFD1;
      flex-shrink: 0;
      border: 1px solid rgba(66, 255, 209, 0.3);
      position: relative;
      overflow: hidden;
    }
    
    .feature-icon::after {
      content: '';
      position: absolute;
      top: -50%;
      left: -50%;
      width: 200%;
      height: 200%;
      background: radial-gradient(circle, rgba(66, 255, 209, 0.4) 0%, transparent 50%);
      opacity: 0;
      transition: opacity 0.3s ease;
    }
    
    .feature-item:hover .feature-icon::after {
      opacity: 1;
    }
    
    .feature-text {
      font-family: var(--font-mono);
      font-size: 1rem;
      color: white;
      font-weight: 500;
    }
    
    .hero-cta {
      display: flex;
      align-items: center;
      gap: 2rem;
    }
    
    .cta-button {
      font-family: var(--font-mono);
      font-size: 1rem;
      font-weight: 700;
      padding: 1rem 2rem;
      border-radius: 6px;
      text-align: center;
      cursor: pointer;
      transition: all 0.3s ease;
      text-transform: uppercase;
      letter-spacing: 1px;
      position: relative;
      overflow: hidden;
      background: linear-gradient(90deg, #42FFD1, #4FB06E);
      color: #0a0a24;
      box-shadow: 0 4px 15px rgba(66, 255, 209, 0.4);
      z-index: 1;
    }
    
    .cta-button::before {
      content: '';
      position: absolute;
      top: 0;
      left: -100%;
      width: 100%;
      height: 100%;
      background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.2), transparent);
      transition: left 0.7s ease;
      z-index: -1;
    }
    
    .cta-button:hover {
      transform: translateY(-3px);
      box-shadow: 0 6px 20px rgba(66, 255, 209, 0.5);
    }
    
    .cta-button:hover::before {
      left: 100%;
    }
    
    .cta-stats {
      display: flex;
      gap: 1.5rem;
    }
    
    .stat {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
    }
    
    .stat-value {
      font-family: var(--font-mono);
      font-size: 1.25rem;
      font-weight: 700;
      color: #42FFD1;
    }
    
    .stat-label {
      font-family: var(--font-mono);
      font-size: 0.75rem;
      color: rgba(255, 255, 255, 0.7);
    }
    
    /* Visualización interactiva */
    .hero-visual {
      display: flex;
      justify-content: center;
      align-items: center;
    }
    
    .visual-container {
      position: relative;
      width: 100%;
      max-width: 550px;
      height: 500px;
    }
    
    .tracing-visual {
      position: relative;
      width: 100%;
      height: 100%;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      z-index: 3;
    }
    
    /* Flujo de trazabilidad */
    .tracing-flow {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      margin-bottom: 2rem;
    }
    
    .flow-section {
      background: rgba(26, 26, 64, 0.6);
      backdrop-filter: blur(10px);
      border-radius: 12px;
      border: 1px solid rgba(66, 255, 209, 0.2);
      padding: 1.25rem;
      box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
      transition: all 0.3s ease;
    }
    
    .flow-section:hover {
      transform: translateY(-5px);
      border-color: rgba(66, 255, 209, 0.6);
      box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3), 0 0 15px rgba(66, 255, 209, 0.3);
    }
    
    .section-header {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      margin-bottom: 1rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px dashed rgba(66, 255, 209, 0.3);
    }
    
    .section-icon {
      color: #42FFD1;
      display: flex;
      align-items: center;
    }
    
    .section-title {
      font-family: var(--font-mono);
      font-size: 0.9rem;
      color: white;
      font-weight: 600;
      letter-spacing: 1px;
    }
    
    .flow-content {
      display: flex;
      align-items: center;
      gap: 1rem;
    }
    
    /* SINIGAN Section */
    .data-document {
      background: rgba(255, 255, 255, 0.9);
      width: 80px;
      height: 100px;
      border-radius: 4px;
      padding: 0.75rem;
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
    }
    
    .doc-line {
      height: 8px;
      background: #0a0a24;
      opacity: 0.6;
      border-radius: 2px;
    }
    
    .doc-line.small {
      width: 60%;
    }
    
    /* Checkpoint Section */
    .checkpoint-cards {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    
    .checkpoint {
      display: flex;
      align-items: center;
      gap: 0.75rem;
      padding: 0.5rem;
      border-radius: 6px;
      background: rgba(255, 255, 255, 0.05);
      transition: all 0.3s ease;
    }
    
    .checkpoint.active {
      background: rgba(66, 255, 209, 0.15);
    }
    
    .checkpoint-dot {
      width: 10px;
      height: 10px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.3);
    }
    
    .checkpoint.active .checkpoint-dot {
      background: #42FFD1;
      box-shadow: 0 0 10px rgba(66, 255, 209, 0.7);
    }
    
    .checkpoint span {
      font-family: var(--font-mono);
      font-size: 0.8rem;
      color: white;
    }
    
    /* Documents Section */
    .doc-stack {
      position: relative;
      width: 80px;
      height: 100px;
    }
    
    .doc {
      position: absolute;
      width: 70px;
      height: 90px;
      background: white;
      border-radius: 4px;
      display: flex;
      align-items: center;
      justify-content: center;
      font-family: var(--font-mono);
      font-weight: bold;
      font-size: 0.9rem;
      color: #0a0a24;
      box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
      transition: all 0.3s ease;
    }
    
    .doc1 {
      bottom: 0;
      left: 0;
      background: #FF7272;
      color: white;
      transform: rotate(-5deg);
      z-index: 3;
    }
    
    .doc2 {
      bottom: 5px;
      left: 5px;
      background: #72C2FF;
      color: white;
      transform: rotate(3deg);
      z-index: 2;
    }
    
    .doc3 {
      bottom: 10px;
      left: 10px;
      background: #FFD972;
      color: #0a0a24;
      transform: rotate(-2deg);
      z-index: 1;
    }
    
    .doc-stack:hover .doc1 {
      transform: translateY(-10px) rotate(-8deg);
    }
    
    .doc-stack:hover .doc2 {
      transform: translateY(-5px) rotate(5deg);
    }
    
    .doc-stack:hover .doc3 {
      transform: translateY(-2px) rotate(-3deg);
    }
    
    /* Animated arrows */
    .anim-arrow {
      flex-grow: 1;
      display: flex;
      align-items: center;
      position: relative;
      height: 2px;
    }
    
    .arrow-pulse {
      position: absolute;
      left: 0;
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #42FFD1;
      animation: pulse-move 3s infinite;
    }
    
    .arrow-line {
      flex-grow: 1;
      height: 1px;
      background: linear-gradient(90deg, #42FFD1, rgba(66, 255, 209, 0.3));
    }
    
    .arrow-head {
      color: #42FFD1;
      font-size: 1.2rem;
      margin-left: 0.25rem;
    }
    
    @keyframes pulse-move {
      0% {
        left: 0;
        opacity: 1;
      }
      90% {
        opacity: 1;
      }
      100% {
        left: 100%;
        opacity: 0;
      }
    }
    

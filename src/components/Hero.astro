<!-- Hero.astro - Componente rediseñado con animación de elementos de trazabilidad -->

<section class="hero-section">
  <div class="hero-background">
    <!-- Elementos animados de fondo -->
    <div class="animated-elements">
      <!-- Estos elementos serán dinamizados con JS -->
    </div>
    
    <!-- Elementos decorativos fijos -->
    <div class="grid-background"></div>
    <div class="scanlines"></div>
    <div class="glow-circle" style="--size: 500px; --top: 30%; --left: 20%; --color: rgba(66, 255, 209, 0.15);"></div>
    <div class="glow-circle" style="--size: 350px; --top: 60%; --left: 80%; --color: rgba(176, 66, 255, 0.1);"></div>
  </div>

  <div class="container">
    <div class="hero-content">
      <div class="hero-text-wrapper">
        <h1 class="hero-title">Trazabilidad inteligente para plantas de beneficio</h1>
        <p class="hero-subtitle">Del campo a la mesa con total transparencia y control en cada etapa del proceso.</p>
        
        <div class="hero-stats">
          <div class="stat-item">
            <div class="stat-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                <line x1="9" y1="10" x2="15" y2="10"></line>
                <line x1="12" y1="7" x2="12" y2="13"></line>
              </svg>
            </div>
            <div class="stat-label">Registros procesados</div>
            <div class="stat-value"><span id="records-counter">0</span>K+</div>
          </div>
          <div class="stat-item">
            <div class="stat-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="10"></circle>
                <polyline points="12 6 12 12 16 14"></polyline>
              </svg>
            </div>
            <div class="stat-label">Horas ahorradas/semana</div>
            <div class="stat-value"><span id="hours-counter">0</span>h</div>
          </div>
          <div class="stat-item">
            <div class="stat-icon">
              <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"></path>
              </svg>
            </div>
            <div class="stat-label">Puntos de integración</div>
            <div class="stat-value"><span id="points-counter">0</span></div>
          </div>
        </div>
        
        <div class="hero-cta">
          <a href="#contacto" class="primary-button">
            Solicitar Demo
            <span class="button-shine"></span>
          </a>
          <a href="#modules" class="secondary-button">
            Descubrir Módulos
          </a>
        </div>
        
        <div class="hero-badge">
          <div class="badge-item">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
            <span>Trazabilidad de próxima generación</span>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Flecha de scroll -->
  <a href="#modules" class="scroll-arrow">
    <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 5v14M5 12l7 7 7-7"/>
    </svg>
  </a>
</section>

<style>
  .hero-section {
    min-height: 100vh;
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    padding: 100px 0;
  }
  
  .hero-background {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 1;
  }
  
  .hero-content {
    position: relative;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    width: 100%;
  }

  .hero-text-wrapper {
    max-width: 650px;
    text-align: center;
    margin: 0 auto;
    animation: fadeIn 1s ease-out;
  }
  
  .hero-title {
    font-size: 3.5rem;
    font-weight: 800;
    margin-bottom: 1.5rem;
    line-height: 1.1;
    background: linear-gradient(90deg, #ffffff, var(--tracingpba-teal));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
  }
  
  .hero-subtitle {
    font-size: 1.25rem;
    margin-bottom: 2.5rem;
    color: rgba(255, 255, 255, 0.8);
    font-family: var(--font-sans);
  }
  
  .hero-stats {
    display: flex;
    justify-content: center;
    gap: 2.5rem;
    margin-bottom: 2.5rem;
  }
  
  .stat-item {
    text-align: center;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }
  
  .stat-icon {
    color: var(--tracingpba-teal);
    height: 40px;
    width: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.9;
    margin-bottom: 0.5rem;
  }
  
  .stat-value {
    font-size: 2.5rem;
    font-weight: 700;
    color: var(--tracingpba-teal);
    margin-top: 0.25rem;
    line-height: 1;
  }
  
  .stat-label {
    font-size: 0.9rem;
    color: rgba(255, 255, 255, 0.7);
    font-family: var(--font-mono);
  }
  
  .hero-cta {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }
  
  .primary-button {
    position: relative;
    background: linear-gradient(90deg, rgba(66, 255, 209, 0.8), rgba(66, 255, 209, 0.6));
    color: #0a2e36;
    font-family: var(--font-mono);
    font-weight: 700;
    font-size: 1rem;
    padding: 0.75rem 1.5rem;
    border-radius: 4px;
    text-decoration: none;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 1px;
    overflow: hidden;
    transition: all 0.3s ease;
    box-shadow: 0 0 20px rgba(66, 255, 209, 0.4);
  }
  
  .primary-button:hover {
    transform: translateY(-3px);
    box-shadow: 0 10px 25px rgba(66, 255, 209, 0.5);
  }
  
  .button-shine {
    position: absolute;
    top: 0;
    left: -100%;
    width: 50%;
    height: 100%;
    background: linear-gradient(
      to right,
      rgba(255, 255, 255, 0) 0%,
      rgba(255, 255, 255, 0.3) 50%,
      rgba(255, 255, 255, 0) 100%
    );
    transform: skewX(-25deg);
    animation: shine 3s infinite;
  }
  
  @keyframes shine {
    0% {
      left: -100%;
    }
    20%, 100% {
      left: 100%;
    }
  }
  
  .secondary-button {
    background: rgba(255, 255, 255, 0.1);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(66, 255, 209, 0.3);
    color: var(--tracingpba-teal);
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 1rem;
    padding: 0.75rem 1.5rem;
    border-radius: 4px;
    text-decoration: none;
    text-align: center;
    text-transform: uppercase;
    letter-spacing: 1px;
    transition: all 0.3s ease;
  }
  
  .secondary-button:hover {
    background: rgba(66, 255, 209, 0.1);
    transform: translateY(-3px);
  }
  
  .hero-badge {
    display: flex;
    justify-content: center;
  }
  
  .badge-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 100px;
    padding: 0.5rem 1rem;
    color: rgba(255, 255, 255, 0.8);
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }
  
  .badge-item svg {
    color: var(--tracingpba-teal);
  }
  
  /* Elementos de fondo */
  .grid-background {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background-image: 
      linear-gradient(to right, rgba(66, 255, 209, 0.05) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(66, 255, 209, 0.05) 1px, transparent 1px);
    background-size: 40px 40px;
    z-index: 1;
  }

  .scanlines {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    overflow: hidden;
    z-index: 2;
    pointer-events: none;
  }

  .scanlines::before {
    content: "";
    position: absolute;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      to bottom,
      transparent 50%,
      rgba(0, 0, 0, 0.05) 51%
    );
    background-size: 100% 4px;
    z-index: 2;
  }

  .glow-circle {
    position: absolute;
    width: var(--size);
    height: var(--size);
    border-radius: 50%;
    top: var(--top);
    left: var(--left);
    background: var(--color);
    filter: blur(80px);
    z-index: 1;
    animation: pulse 10s ease-in-out infinite alternate;
  }

  .animated-elements {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 2;
    pointer-events: none;
  }

  .scroll-arrow {
    position: absolute;
    bottom: 30px;
    left: 50%;
    transform: translateX(-50%);
    color: var(--tracingpba-teal);
    animation: bounce 2s infinite;
    z-index: 10;
    opacity: 0.8;
    transition: opacity 0.3s;
  }

  .scroll-arrow:hover {
    opacity: 1;
  }

  @keyframes bounce {
    0%, 20%, 50%, 80%, 100% {
      transform: translateY(0) translateX(-50%);
    }
    40% {
      transform: translateY(-10px) translateX(-50%);
    }
    60% {
      transform: translateY(-5px) translateX(-50%);
    }
  }
  
  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @keyframes pulse {
    0%, 100% {
      opacity: 0.7;
    }
    50% {
      opacity: 1;
    }
  }
  
  /* Media Queries */
  @media (max-width: 1100px) {
    .hero-content {
      text-align: center;
    }
    
    .hero-text-wrapper {
      max-width: 100%;
    }
  }
  
  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.5rem;
    }
    
    .hero-subtitle {
      font-size: 1.1rem;
    }
    
    .hero-stats {
      gap: 1.5rem;
    }
    
    .stat-number {
      font-size: 2rem;
    }
    
    .hero-cta {
      flex-direction: column;
    }
    
    .primary-button, .secondary-button {
      width: 100%;
    }
  }
  
  @media (max-width: 576px) {
    .hero-section {
      padding: 80px 0 60px;
    }
    
    .hero-title {
      font-size: 2rem;
    }
    
    .hero-stats {
      flex-direction: column;
      gap: 1rem;
    }
  }
</style>

<script>
  // Define interfaces para TypeScript
  interface AnimatedElementOptions {
    size?: number;
    speed?: number;
    rotation?: number;
    delay?: number;
    startX?: number;
    startY?: number;
    opacity?: number;
    animation?: string;
    [key: string]: any;
  }

  // Clase para manejar los elementos de animación
  class AnimatedElement {
    type: string;
    options: AnimatedElementOptions;
    element: HTMLElement;

    constructor(type: string, options: AnimatedElementOptions = {}) {
      this.type = type;
      this.options = {
        size: options.size || Math.random() * 40 + 20,
        speed: options.speed || Math.random() * 5 + 2,
        rotation: options.rotation || Math.random() * 360,
        delay: options.delay || Math.random() * 5,
        startX: options.startX || Math.random() * 100,
        startY: options.startY || -10 - Math.random() * 10,
        opacity: options.opacity || Math.random() * 0.3 + 0.1,
        animation: options.animation || 'linear',
        ...options
      };
      this.element = this.createElementByType();
      this.init();
    }
    
    createElementByType(): HTMLElement {
      const el = document.createElement('div');
      el.classList.add('animated-item', `item-${this.type}`);
      
      // Dependiendo del tipo, crear diferentes elementos
      switch(this.type) {
        case 'cow':
          el.innerHTML = `<svg width="${this.options.size}" height="${this.options.size}" viewBox="0 0 24 24" fill="none" stroke="rgba(66, 255, 209, ${this.options.opacity})" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 3a4 4 0 0 0-4 4v3a4 4 0 0 0 4 4h1a4 4 0 0 0 4-4V6a4 4 0 0 0-4-4Z"></path>
            <path d="M20 3a4 4 0 0 0-4 4v3a4 4 0 0 0 4 4h1a4 4 0 0 0 4-4V6a4 4 0 0 0-4-4Z"></path>
            <path d="M5 11v4a7 7 0 0 0 7 7v0a7 7 0 0 0 7-7v-4"></path>
            <line x1="8" y1="15" x2="10" y2="15"></line>
            <line x1="14" y1="15" x2="16" y2="15"></line>
          </svg>`;
          break;
        case 'pig':
          el.innerHTML = `<svg width="${this.options.size}" height="${this.options.size}" viewBox="0 0 24 24" fill="none" stroke="rgba(255, 66, 114, ${this.options.opacity})" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 22c5.5 0 10-4.5 10-10S17.5 2 12 2 2 6.5 2 12s4.5 10 10 10z"></path>
            <path d="M8 11v.01M16 11v.01"></path>
            <path d="M2 12h1M4 9h1M4 15h1M6 6.8l.7.7M6 17.2l.7-.7"></path>
            <path d="M12 5c-1.107-.72-2.435-1-4-1-1.567 0-2.893.28-4 1"></path>
            <path d="M15 8a1 1 0 0 1 0 2 1 1 0 0 1 0-2zM9 8a1 1 0 0 1 0 2 1 1 0 0 1 0-2z"></path>
            <path d="M12 16v.01"></path>
          </svg>`;
          break;
        case 'dataflow':
          el.innerHTML = `<svg width="${this.options.size ? this.options.size * 1.5 : 30}" height="${this.options.size}" viewBox="0 0 24 24" fill="none" stroke="rgba(66, 255, 209, ${this.options.opacity})" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
            <rect x="2" y="2" width="4" height="4" rx="1"></rect>
            <rect x="2" y="10" width="4" height="4" rx="1"></rect>
            <rect x="2" y="18" width="4" height="4" rx="1"></rect>
            <rect x="10" y="2" width="4" height="4" rx="1"></rect>
            <rect x="10" y="10" width="4" height="4" rx="1"></rect>
            <rect x="10" y="18" width="4" height="4" rx="1"></rect>
            <rect x="18" y="2" width="4" height="4" rx="1"></rect>
            <rect x="18" y="10" width="4" height="4" rx="1"></rect>
            <rect x="18" y="18" width="4" height="4" rx="1"></rect>
            <path d="M6 4h4"></path>
            <path d="M14 4h4"></path>
            <path d="M6 12h4"></path>
            <path d="M14 12h4"></path>
            <path d="M6 20h4"></path>
            <path d="M14 20h4"></path>
            <path d="M4 6v4"></path>
            <path d="M4 14v4"></path>
            <path d="M12 6v4"></path>
            <path d="M12 14v4"></path>
            <path d="M20 6v4"></path>
            <path d="M20 14v4"></path>
          </svg>`;
          break;
        case 'tag':
          el.innerHTML = `<svg width="${this.options.size}" height="${this.options.size}" viewBox="0 0 24 24" fill="none" stroke="rgba(176, 66, 255, ${this.options.opacity})" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2H2v10l9.29 9.29c.94.94 2.48.94 3.42 0l6.58-6.58c.94-.94.94-2.48 0-3.42L12 2Z"></path>
            <path d="M7 7h.01"></path>
          </svg>`;
          break;
        case 'barcode':
          el.innerHTML = `<svg width="${this.options.size ? this.options.size * 1.5 : 30}" height="${this.options.size}" viewBox="0 0 24 24" fill="none" stroke="rgba(255, 255, 255, ${this.options.opacity})" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 5v14"></path>
            <path d="M8 5v14"></path>
            <path d="M12 5v14"></path>
            <path d="M17 5v14"></path>
            <path d="M21 5v14"></path>
          </svg>`;
          break;
        case 'node':
          el.style.width = `${this.options.size}px`;
          el.style.height = `${this.options.size}px`;
          el.style.backgroundColor = `rgba(66, 255, 209, ${this.options.opacity})`;
          el.style.borderRadius = '50%';
          // Corregir el error de objeto posiblemente undefined
          const shadowSize = this.options.size ? this.options.size / 2 : 10;
          el.style.boxShadow = `0 0 ${shadowSize}px rgba(66, 255, 209, ${this.options.opacity})`;
          break;
        case 'branding-iron':
          el.innerHTML = `<svg width="${this.options.size}" height="${this.options.size}" viewBox="0 0 24 24" fill="none" stroke="rgba(255, 160, 66, ${this.options.opacity})" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="14" cy="6" r="4"></circle>
            <path d="M14 10v8"></path>
            <path d="M10 14h8"></path>
            <path d="M16 18v2"></path>
            <path d="M8 6h.01"></path>
          </svg>`;
          break;
        case 'bull':
          el.innerHTML = `<svg width="${this.options.size}" height="${this.options.size}" viewBox="0 0 24 24" fill="none" stroke="rgba(255, 120, 66, ${this.options.opacity})" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 7h10"></path>
            <path d="M12 7h10"></path>
            <path d="M7 2l.5 5"></path>
            <path d="M17 2l-.5 5"></path>
            <path d="M7 14c.64 1.26 1.7 2 3 2h4c1.3 0 2.36-.74 3-2"></path>
            <path d="M5 18a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4H5v4z"></path>
          </svg>`;
          break;
        case 'chart':
          el.innerHTML = `<svg width="${this.options.size}" height="${this.options.size}" viewBox="0 0 24 24" fill="none" stroke="rgba(66, 200, 255, ${this.options.opacity})" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
            <line x1="3" y1="9" x2="21" y2="9"></line>
            <line x1="9" y1="21" x2="9" y2="9"></line>
            <line x1="7" y1="15" x2="8" y2="15"></line>
            <line x1="14" y1="15" x2="16" y2="15"></line>
            <line x1="7" y1="18" x2="8" y2="18"></line>
            <line x1="14" y1="18" x2="16" y2="18"></line>
          </svg>`;
          break;
        case 'gauge':
          el.innerHTML = `<svg width="${this.options.size}" height="${this.options.size}" viewBox="0 0 24 24" fill="none" stroke="rgba(255, 66, 200, ${this.options.opacity})" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 2a10 10 0 1 0 0 20 10 10 0 0 0 0-20Z"></path>
            <path d="M12 12 7 7"></path>
            <path d="M12 12v5"></path>
          </svg>`;
          break;
        case 'stethoscope':
          el.innerHTML = `<svg width="${this.options.size}" height="${this.options.size}" viewBox="0 0 24 24" fill="none" stroke="rgba(130, 255, 66, ${this.options.opacity})" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4.7 19.3a9 9 0 1 1 14.6 0"></path>
            <path d="M4 15.24A7 7 0 0 1 3 12c0-3.87 3.13-7 7-7h4c3.87 0 7 3.13 7 7a7 7 0 0 1-1 3.24"></path>
            <line x1="12" y1="8" x2="12" y2="12"></line>
            <line x1="12" y1="16" x2="12" y2="16"></line>
          </svg>`;
          break;
        case 'syringe':
          el.innerHTML = `<svg width="${this.options.size}" height="${this.options.size}" viewBox="0 0 24 24" fill="none" stroke="rgba(66, 255, 150, ${this.options.opacity})" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
            <path d="m14 16-4-4"></path>
            <path d="m4 6 14 14"></path>
            <path d="m11.5 13.5 1 1"></path>
            <path d="m10 7 5 5"></path>
            <path d="m9 6 6 6"></path>
            <path d="m13 14-1.5-1.5"></path>
            <path d="M4 18h.01"></path>
          </svg>`;
          break;
        case 'thermometer':
          el.innerHTML = `<svg width="${this.options.size}" height="${this.options.size}" viewBox="0 0 24 24" fill="none" stroke="rgba(255, 66, 87, ${this.options.opacity})" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14 4v10.54a4 4 0 1 1-4 0V4a2 2 0 0 1 4 0Z"></path>
            <path d="M12 9a1 1 0 0 0-1 1v6.54a1 1 0 0 0 2 0V10a1 1 0 0 0-1-1Z"></path>
          </svg>`;
          break;
        case 'scales':
          el.innerHTML = `<svg width="${this.options.size}" height="${this.options.size}" viewBox="0 0 24 24" fill="none" stroke="rgba(220, 255, 66, ${this.options.opacity})" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
            <path d="m3 7 3-3 3 3"></path>
            <path d="M6 4v6"></path>
            <path d="m15 7 3-3 3 3"></path>
            <path d="M18 4v6"></path>
            <path d="M3 17h18"></path>
            <path d="M6 17v3"></path>
            <path d="M18 17v3"></path>
          </svg>`;
          break;
        case 'farm':
          el.innerHTML = `<svg width="${this.options.size}" height="${this.options.size}" viewBox="0 0 24 24" fill="none" stroke="rgba(167, 146, 94, ${this.options.opacity})" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
            <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            <polyline points="9 22 9 12 15 12 15 22"></polyline>
            <path d="M5 8a1 1 0 0 1 1-1h12a1 1 0 0 1 1 1v1H5V8z"></path>
          </svg>`;
          break;
        case 'dashboard':
          el.innerHTML = `<svg width="${this.options.size}" height="${this.options.size}" viewBox="0 0 24 24" fill="none" stroke="rgba(66, 255, 209, ${this.options.opacity})" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
            <rect x="3" y="3" width="7" height="9"></rect>
            <rect x="14" y="3" width="7" height="5"></rect>
            <rect x="14" y="12" width="7" height="9"></rect>
            <rect x="3" y="16" width="7" height="5"></rect>
          </svg>`;
          break;
        default:
          el.style.width = `${this.options.size}px`;
          el.style.height = `${this.options.size}px`;
          el.style.backgroundColor = `rgba(66, 255, 209, ${this.options.opacity})`;
      }
      
      return el;
    }
    
    init(): void {
      const container = document.querySelector('.animated-elements');
      if (!container) return;
      
      this.element.style.position = 'absolute';
      this.element.style.left = `${this.options.startX}%`;
      this.element.style.top = `${this.options.startY}%`;
      this.element.style.transform = `rotate(${this.options.rotation}deg)`;
      this.element.style.opacity = `${this.options.opacity}`;
      
      // Establecer la animación
      this.element.style.transition = `top ${this.options.speed}s ${this.options.animation}, left ${this.options.speed}s ${this.options.animation}, transform ${this.options.speed}s ${this.options.animation}`;
      
      container.appendChild(this.element);
      
      // Iniciar la animación después de un breve delay para permitir que la transición funcione
      setTimeout(() => {
        this.animate();
      }, (this.options.delay || 0) * 1000);
    }
    
    animate(): void {
      // Crear diferentes patrones de movimiento para mayor variedad visual
      // Algunos elementos van directo hacia abajo, otros en diagonal, etc.
      let newY, newX, newRotation;
      
      // Patrón aleatorio de movimiento (3 tipos)
      const motionPattern = Math.floor(Math.random() * 3);
      
      switch(motionPattern) {
        case 0: // Diagonal hacia abajo-izquierda (como tembo)
          newY = 110 + Math.random() * 20;
          newX = (this.options.startX || 0) - (Math.random() * 60) - 10;
          newRotation = (this.options.rotation || 0) + (Math.random() * 180 - 90);
          break;
        case 1: // Diagonal hacia abajo-derecha
          newY = 110 + Math.random() * 20;
          newX = (this.options.startX || 0) + (Math.random() * 60) - 10;
          newRotation = (this.options.rotation || 0) + (Math.random() * 180 - 90);
          break;
        case 2: // Directo hacia abajo (caída)
          newY = 110 + Math.random() * 20;
          newX = (this.options.startX || 0) + (Math.random() * 10 - 5); // Ligera variación horizontal
          newRotation = (this.options.rotation || 0) + (Math.random() * 90 - 45); // Menos rotación
          break;
      }
      
      this.element.style.top = `${newY}%`;
      this.element.style.left = `${newX}%`;
      this.element.style.transform = `rotate(${newRotation}deg)`;
      
      // Cuando la animación termine, eliminar y recrear
      setTimeout(() => {
        this.element.remove();
        // Variar la posición de inicio para distribución por toda la pantalla
        this.options.startY = -10 - Math.random() * 10;
        this.options.startX = Math.random() * 100;
        this.options.rotation = Math.random() * 360;
        this.element = this.createElementByType();
        this.init();
      }, (this.options.speed || 3) * 1000);
    }
  }
  
  // Inicializar todo cuando el DOM esté listo
  document.addEventListener('DOMContentLoaded', () => {
    // Crear elementos animados - tipos ampliados
    const types = [
      'cow', 'pig', 'dataflow', 'tag', 'barcode', 'node', 
      'branding-iron', 'bull', 'chart', 'gauge', 'stethoscope', 
      'syringe', 'thermometer', 'scales', 'farm', 'dashboard'
    ];
    const elementCount = window.innerWidth < 768 ? 30 : 60; // Aumentado significativamente el número de elementos
    
    for (let i = 0; i < elementCount; i++) {
      const randomType = types[Math.floor(Math.random() * types.length)];
      
      // Variar el tamaño según el tipo para elementos más interesantes
      let size, opacity, speed;
      
      // Personalizar tamaños y velocidades según el tipo
      switch(randomType) {
        case 'bull':
        case 'cow':
          size = Math.random() * 35 + 25; // Animales más grandes
          opacity = Math.random() * 0.3 + 0.15;
          speed = Math.random() * 6 + 6; // Más lentos
          break;
        case 'branding-iron':
          size = Math.random() * 25 + 20;
          opacity = Math.random() * 0.4 + 0.2;
          speed = Math.random() * 7 + 5;
          break;
        case 'dashboard':
        case 'chart':
          size = Math.random() * 40 + 30; // Elementos de dashboard más grandes
          opacity = Math.random() * 0.35 + 0.15;
          speed = Math.random() * 5 + 4;
          break;
        case 'stethoscope':
        case 'syringe':
        case 'thermometer':
          size = Math.random() * 25 + 15; // Instrumentos médicos
          opacity = Math.random() * 0.3 + 0.2;
          speed = Math.random() * 6 + 5;
          break;
        default:
          size = Math.random() * 30 + 15;
          opacity = Math.random() * 0.3 + 0.1;
          speed = Math.random() * 8 + 4;
      }
      
      new AnimatedElement(randomType, {
        size: size,
        speed: speed,
        opacity: opacity,
        delay: Math.random() * 15 // Mayor variación en el delay para distribución más natural
      });
    }
    
    // Animación de contadores - con valores fijos y límites
    function animateCounter(elementId: string, targetValue: number, duration = 2000): void {
      const element = document.getElementById(elementId);
      if (!element) return;
      
      const startValue = 0;
      const increment = 1;
      const stepTime = Math.abs(Math.floor(duration / (targetValue - startValue)));
      
      let currentValue = startValue;
      const timer = setInterval(() => {
        currentValue += increment;
        element.textContent = currentValue.toString();
        if (currentValue >= targetValue) {
          element.textContent = targetValue.toString();
          clearInterval(timer);
        }
      }, stepTime);
    }
    
    // Iniciar animaciones de contadores con un ligero retraso
    setTimeout(() => {
      // Usar valores objetivos no porcentuales
      animateCounter('records-counter', 100, 1500); // Miles de registros procesados
      animateCounter('hours-counter', 36, 1500);   // Horas ahorradas por semana
      animateCounter('points-counter', 8, 1500);   // Puntos de integración
    }, 500);
    
    // Animación al hacer scroll
    const handleScroll = () => {
      const scrollY = window.scrollY || window.pageYOffset;
      const parallaxElements = document.querySelectorAll('.glow-circle');
      
      parallaxElements.forEach(el => {
        const speed = 0.05;
        const yPos = -scrollY * speed;
        if (el instanceof HTMLElement) {
          el.style.transform = `translateY(${yPos}px)`;
        }
      });
    };
    
    window.addEventListener('scroll', handleScroll);
  });
</script> 
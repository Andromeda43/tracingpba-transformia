<!-- Hero.astro - Componente mejorado con animación de proceso y mini-dashboard -->

<section class="hero-section">
  <div class="container">
    <div class="hero-content">
      <div class="hero-text">
        <h1 class="hero-title">Trazabilidad inteligente para plantas de beneficio</h1>
        <p class="hero-subtitle">Del campo a la mesa con total transparencia y control en cada etapa del proceso.</p>
        <div class="hero-cta">
          <a href="#contacto" class="cybr-btn">
            Solicitar Demo
            <span aria-hidden class="cybr-btn__glitch">Solicitar Demo</span>
          </a>
          <a href="#modules" class="cybr-btn cybr-btn--secondary">
            Descubrir Módulos
            <span aria-hidden class="cybr-btn__glitch">Descubrir Módulos</span>
          </a>
        </div>
      </div>
      
      <div class="hero-visual">
        <!-- Animación principal del proceso -->
        <div class="process-animation">
          <div class="animation-container">
            <!-- Esta es la animación SVG que se cargará mediante JS -->
            <div id="animation-element"></div>
            
            <!-- Mini dashboard flotante -->
            <div class="mini-dashboard">
              <div class="dashboard-header">
                <div class="dashboard-title">Monitor de Proceso</div>
                <div class="dashboard-controls">
                  <span class="control-dot"></span>
                  <span class="control-dot"></span>
                  <span class="control-dot"></span>
                </div>
              </div>
              <div class="dashboard-body">
                <div class="data-row">
                  <div class="data-label">Animales en proceso:</div>
                  <div class="data-value" id="animals-in-process">24</div>
                </div>
                <div class="data-row">
                  <div class="data-label">Eficiencia:</div>
                  <div class="data-value"><span id="efficiency-value">98.2</span>%</div>
                </div>
                <div class="data-row">
                  <div class="data-label">Estado:</div>
                  <div class="data-value status-active">Activo</div>
                </div>
                <div class="data-chart">
                  <div class="chart-bar" style="--height: 30%"></div>
                  <div class="chart-bar" style="--height: 45%"></div>
                  <div class="chart-bar" style="--height: 65%"></div>
                  <div class="chart-bar" style="--height: 80%"></div>
                  <div class="chart-bar" style="--height: 60%"></div>
                  <div class="chart-bar" style="--height: 75%"></div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
  
  <!-- Elementos decorativos de fondo -->
  <div class="grid-background"></div>
  <div class="scanlines"></div>
  <div class="neon-circle" style="--size: 300px; --top: 20%; --left: 15%; --color: rgba(66, 255, 209, 0.2); --delay: 0s;"></div>
  <div class="neon-circle" style="--size: 200px; --top: 60%; --left: 75%; --color: rgba(176, 66, 255, 0.15); --delay: 2s;"></div>
  
  <!-- Flecha de scroll -->
  <a href="#modules" class="scroll-arrow">
    <svg xmlns="http://www.w3.org/2000/svg" width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 5v14M5 12l7 7 7-7"/>
    </svg>
  </a>
</section>

<style>
  .hero-section {
    min-height: 100vh;
    position: relative;
    display: flex;
    align-items: center;
    overflow: hidden;
    padding: 120px 0 80px;
  }
  
  .hero-content {
    display: flex;
    align-items: center;
    justify-content: space-between;
    position: relative;
    z-index: 10;
  }
  
  .hero-text {
    flex: 1;
    max-width: 500px;
    animation: fadeIn 1s ease-out;
  }
  
  .hero-title {
    font-size: 3.5rem;
    font-weight: 800;
    margin-bottom: 1.5rem;
    line-height: 1.1;
    background: linear-gradient(90deg, #ffffff, var(--tracingpba-teal));
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    color: transparent;
  }
  
  .hero-subtitle {
    font-size: 1.25rem;
    margin-bottom: 2.5rem;
    color: rgba(255, 255, 255, 0.8);
    font-family: var(--font-sans);
  }
  
  .hero-cta {
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }
  
  .hero-visual {
    flex: 1;
    position: relative;
  }
  
  .process-animation {
    position: relative;
    width: 100%;
    height: 500px;
  }
  
  .animation-container {
    position: relative;
    width: 100%;
    height: 100%;
  }
  
  /* Mini dashboard */
  .mini-dashboard {
    position: absolute;
    bottom: 30px;
    right: 30px;
    width: 280px;
    background: rgba(10, 10, 20, 0.7);
    backdrop-filter: blur(10px);
    border: 1px solid rgba(66, 255, 209, 0.3);
    border-radius: 10px;
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3), 0 0 15px rgba(66, 255, 209, 0.1);
    z-index: 20;
    animation: fadeIn 1s ease-out 0.5s both;
    overflow: hidden;
  }
  
  .dashboard-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 15px;
    background: rgba(26, 26, 64, 0.8);
    border-bottom: 1px solid rgba(66, 255, 209, 0.2);
  }
  
  .dashboard-title {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--tracingpba-teal);
    text-transform: uppercase;
    letter-spacing: 1px;
  }
  
  .dashboard-controls {
    display: flex;
    gap: 5px;
  }
  
  .control-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: rgba(255, 255, 255, 0.5);
  }
  
  .control-dot:first-child {
    background-color: var(--tracingpba-teal);
    box-shadow: 0 0 5px var(--tracingpba-teal);
  }
  
  .dashboard-body {
    padding: 15px;
  }
  
  .data-row {
    display: flex;
    justify-content: space-between;
    margin-bottom: 10px;
    font-size: 0.8rem;
  }
  
  .data-label {
    color: rgba(255, 255, 255, 0.7);
    font-family: var(--font-mono);
  }
  
  .data-value {
    font-family: var(--font-mono);
    font-weight: 700;
    color: white;
  }
  
  .status-active {
    color: var(--tracingpba-teal);
    position: relative;
  }
  
  .status-active::before {
    content: '';
    display: inline-block;
    width: 6px;
    height: 6px;
    background-color: var(--tracingpba-teal);
    border-radius: 50%;
    margin-right: 5px;
    animation: blink 2s infinite;
  }
  
  .data-chart {
    display: flex;
    align-items: flex-end;
    height: 50px;
    gap: 4px;
    margin-top: 15px;
  }
  
  .chart-bar {
    flex: 1;
    height: var(--height);
    background: linear-gradient(to top, var(--tracingpba-teal), rgba(66, 255, 209, 0.3));
    border-radius: 2px 2px 0 0;
  }
  
  @media (max-width: 1100px) {
    .hero-content {
      flex-direction: column;
      text-align: center;
    }
    
    .hero-text {
      max-width: 700px;
      margin-bottom: 3rem;
    }
    
    .hero-cta {
      justify-content: center;
    }
    
    .process-animation {
      height: 400px;
    }
  }
  
  @media (max-width: 768px) {
    .hero-title {
      font-size: 2.5rem;
    }
    
    .hero-subtitle {
      font-size: 1.1rem;
    }
    
    .process-animation {
      height: 350px;
    }
    
    .mini-dashboard {
      width: 240px;
      bottom: 20px;
      right: 20px;
    }
  }
  
  @media (max-width: 576px) {
    .hero-section {
      padding: 100px 0 60px;
    }
    
    .hero-title {
      font-size: 2rem;
    }
    
    .process-animation {
      height: 300px;
    }
    
    .mini-dashboard {
      width: 200px;
      bottom: 10px;
      right: 10px;
    }
  }

  @keyframes fadeIn {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  @keyframes blink {
    0%, 100% {
      opacity: 1;
    }
    50% {
      opacity: 0.5;
    }
  }
</style>

<script>
  // Cargar script de Lottie
  document.addEventListener('DOMContentLoaded', () => {
    const script = document.createElement('script');
    script.src = 'https://cdnjs.cloudflare.com/ajax/libs/lottie-web/5.12.2/lottie.min.js';
    script.onload = initAnimation;
    document.head.appendChild(script);
  });

  // Inicializar la animación cuando el script esté cargado
  function initAnimation() {
    const animationContainer = document.getElementById('animation-element');
    
    if (animationContainer && window.lottie) {
      // Esta es la configuración para cargar la animación JSON
      const animation = window.lottie.loadAnimation({
        container: animationContainer,
        renderer: 'svg',
        loop: true,
        autoplay: true,
        path: '/animations/process-animation.json',
      });
      
      // Fallback en caso de que la animación no cargue
      animation.addEventListener('data_failed', () => {
        console.warn('La animación falló al cargar. Mostrando imagen estática como respaldo.');
        if (animationContainer) {
          animationContainer.innerHTML = `
            <div class="fallback-animation">
              <img src="/images/process-static.svg" alt="Proceso de trazabilidad" />
            </div>
          `;
        }
      });
      
      // Optimización: pausa la animación cuando no es visible
      if (window.IntersectionObserver) {
        const observer = new IntersectionObserver((entries) => {
          entries.forEach(entry => {
            if (entry.isIntersecting) {
              animation.play();
            } else {
              animation.pause();
            }
          });
        }, { threshold: 0.1 });
        
        observer.observe(animationContainer);
      }
    }
    
    // Animación de datos para el mini dashboard
    initDashboardAnimation();
  }

  // Inicializar animación del dashboard
  function initDashboardAnimation() {
    let currentAnimals = 18;
    const maxAnimals = 30;
    const minAnimals = 12;
    const animalsElement = document.getElementById('animals-in-process');
    const efficiencyElement = document.getElementById('efficiency-value');
    
    // Actualizar valores periódicamente para dar sensación de datos en vivo
    setInterval(() => {
      if (Math.random() > 0.5) {
        currentAnimals = Math.min(currentAnimals + Math.floor(Math.random() * 3), maxAnimals);
      } else {
        currentAnimals = Math.max(currentAnimals - Math.floor(Math.random() * 3), minAnimals);
      }
      
      if (animalsElement) {
        animalsElement.textContent = currentAnimals.toString();
      }
      
      if (efficiencyElement) {
        const efficiency = (97 + Math.random() * 2).toFixed(1);
        efficiencyElement.textContent = efficiency.toString();
      }
      
      // Actualizar las barras del gráfico
      const chartBars = document.querySelectorAll('.chart-bar');
      chartBars.forEach(bar => {
        const newHeight = 30 + Math.random() * 60;
        bar.style.setProperty('--height', `${newHeight}%`);
      });
    }, 3000);
  }
</script>
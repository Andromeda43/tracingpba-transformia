---
import MainLayout from '../layouts/MainLayout.astro';
import '../styles/global.css';
import '../styles/tracingpba.css';
---

<MainLayout title="TracingPBA - Trazabilidad 360° para Plantas de Beneficio Animal | Transformia">
  <!-- Hero Section -->
  <section class="hero tracingpba-hero">
    <!-- Elementos de fondo y decoración -->
    <div class="grid-background"></div>
    <div class="scanlines"></div>
    
    <div class="neon-circle" style="--size: 300px; --top: 20%; --left: 10%; --color: rgba(176, 66, 255, 0.2); --delay: 0s;"></div>
    <div class="neon-circle" style="--size: 200px; --top: 60%; --left: 70%; --color: rgba(66, 255, 209, 0.2); --delay: 2s;"></div>
    
    <div class="geometric-element rect-element" style="--size: 40px; --top: 15%; --left: 85%; --rotate: 45deg;"></div>
    <div class="geometric-element triangle-element" style="--size: 50px; --top: 75%; --left: 15%; --rotate: 30deg;"></div>
    <div class="geometric-element cross-element" style="--size: 35px; --top: 25%; --left: 25%; --rotate: 15deg;"></div>
    
    <div class="particles-container">
      <div class="particle" style="--size: 4px; --top: 20%; --left: 30%; --speed: 20s;"></div>
      <div class="particle" style="--size: 3px; --top: 40%; --left: 60%; --speed: 15s;"></div>
      <div class="particle" style="--size: 5px; --top: 70%; --left: 40%; --speed: 25s;"></div>
      <div class="particle" style="--size: 2px; --top: 30%; --left: 80%; --speed: 18s;"></div>
    </div>
    
    <div class="container">
      <div class="hero-content">
        <div class="hero-text-container animate-on-scroll">
          <h1 class="hero-title">Trazabilidad <span class="hero-title-accent">360°</span> para tu Planta de Beneficio Animal</h1>
          <p class="tagline">Automatiza <span class="highlight">SINIGAN</span>, precintos y reportes — en minutos, no en horas.</p>
          <p class="hero-description">TracingPBA centraliza la recepción de ganado, controla cada checkpoint y genera la documentación que exige el INVIMA, todo en una sola suite cloud.</p>
          
          <div class="hero-bullets">
            <div class="hero-bullet">
              <div class="bullet-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M21 12V7H5a2 2 0 0 1 0-4h14v4"></path>
                  <path d="M3 5v14a2 2 0 0 0 2 2h16v-5"></path>
                  <path d="M15 14h6"></path>
                </svg>
              </div>
              <div class="bullet-text">Sin API oficial: scraping certificado de guías SINIGAN</div>
            </div>
            
            <div class="hero-bullet">
              <div class="bullet-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M17 2h3a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h3"></path>
                  <path d="M7 2v4"></path>
                  <path d="M17 2v4"></path>
                  <path d="M2 10h20"></path>
                </svg>
              </div>
              <div class="bullet-text">Precintos listos: 100 etiquetas únicas en menos de 25 segundos</div>
            </div>
            
            <div class="hero-bullet">
              <div class="bullet-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
                  <line x1="3" y1="9" x2="21" y2="9"></line>
                  <line x1="9" y1="21" x2="9" y2="9"></line>
                </svg>
              </div>
              <div class="bullet-text">Dashboard interactivo con filtros cruzados</div>
            </div>
            
            <div class="hero-bullet">
              <div class="bullet-icon">
                <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                  <polyline points="14 2 14 8 20 8"></polyline>
                  <line x1="16" y1="13" x2="8" y2="13"></line>
                  <line x1="16" y1="17" x2="8" y2="17"></line>
                  <polyline points="10 9 9 9 8 9"></polyline>
                </svg>
              </div>
              <div class="bullet-text">PDFs: guías de despacho, certificados de beneficio y calidad</div>
            </div>
          </div>
          
          <div class="btn-container">
            <a href="#demo" class="cybr-btn">
              Probar demo interactiva
              <span class="cybr-btn__glitch"></span>
            </a>
            <a href="#ficha" class="cybr-btn cybr-btn--secondary">
              Descargar ficha técnica
              <span class="cybr-btn__glitch"></span>
            </a>
          </div>
        </div>
        
        <div class="hero-visual animate-on-scroll">
          <div class="terminal-container">
            <div class="terminal">
              <div class="terminal-header">
                <div class="terminal-button"></div>
                <div class="terminal-button"></div>
                <div class="terminal-button"></div>
                <span class="terminal-title">TracingPBA</span>
              </div>
              <div class="terminal-content">
                <div class="terminal-line">
                  <span class="terminal-prompt">$</span>
                  <span class="terminal-text typing-effect">Iniciando sistema de trazabilidad...</span>
                </div>
                <div class="terminal-line" style="animation-delay: 1s;">
                  <span class="terminal-prompt">></span>
                  <span class="terminal-text">Conectando con SINIGAN...</span>
                </div>
                <div class="terminal-line" style="animation-delay: 2s;">
                  <span class="terminal-prompt">></span>
                  <span class="terminal-text">Extrayendo datos de guías de movilización</span>
                </div>
                <div class="terminal-line" style="animation-delay: 3s;">
                  <span class="terminal-prompt">></span>
                  <span class="terminal-text">Checkpoints activados: Corrales, Proceso, Almacenamiento</span>
                </div>
                <div class="terminal-line" style="animation-delay: 4s;">
                  <span class="terminal-prompt">></span>
                  <span class="terminal-text">Dashboard listo - 8,009 animales registrados</span>
                </div>
                <div class="terminal-status-bar">
                  <div class="status-indicator active"></div>
                  <span class="status-text">Sistema operativo</span>
                </div>
              </div>
            </div>
            
            <!-- Elementos decorativos -->
            <div class="circuit-line cl-1"></div>
            <div class="circuit-node cn-1"></div>
            <div class="circuit-line cl-2"></div>
            <div class="circuit-node cn-2"></div>
            <div class="circuit-line cl-3"></div>
          </div>
        </div>
      </div>
    </div>
    
    <div class="scroll-arrow">
      <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="12" y1="5" x2="12" y2="19"></line>
        <polyline points="19 12 12 19 5 12"></polyline>
      </svg>
    </div>
  </section>

  <!-- Pain Points Section -->
  <section class="pain-points-section" id="pain-points">
    <div class="container">
      <h2 class="section-title animate-on-scroll">Problemas que resolvemos</h2>
      
      <div class="pain-points-grid">
        <div class="pain-point-card animate-on-scroll">
          <div class="pain-point-number">01</div>
          <h3 class="pain-point-title">Doble digitación</h3>
          <p class="pain-point-description">
            Copiar la guía SINIGAN a Excel ya no es opción: es tiempo perdido y errores caros.
          </p>
          <div class="pain-point-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="22 12 18 12 15 21 9 3 6 12 2 12"></polyline>
            </svg>
          </div>
        </div>
        
        <div class="pain-point-card animate-on-scroll">
          <div class="pain-point-number">02</div>
          <h3 class="pain-point-title">Precintos manuales</h3>
          <p class="pain-point-description">
            El software de la impresora no escala: personal a tiempo completo solo para imprimir.
          </p>
          <div class="pain-point-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 14V2"></path>
              <path d="M9 18.12v-1"></path>
              <path d="M13 18.12v-1"></path>
              <path d="M17 18.12v-1"></path>
              <path d="M21 18.12v-1"></path>
              <path d="M3 14V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"></path>
            </svg>
          </div>
        </div>
        
        <div class="pain-point-card animate-on-scroll">
          <div class="pain-point-number">03</div>
          <h3 class="pain-point-title">Auditorías sorpresa</h3>
          <p class="pain-point-description">
            Invima exige trazabilidad en segundos; tú necesitas los datos antes que ellos.
          </p>
          <div class="pain-point-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="10"></circle>
              <line x1="12" y1="8" x2="12" y2="12"></line>
              <line x1="12" y1="16" x2="12.01" y2="16"></line>
            </svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Modules Section -->
  <section class="modules-section" id="modules">
    <div class="container">
      <h2 class="section-title animate-on-scroll">Módulos Actuales</h2>
      
      <div class="modules-grid">
        <!-- Módulo 1 -->
        <div class="module-card animate-on-scroll">
          <div class="module-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="2" y="3" width="20" height="14" rx="2" ry="2"></rect>
              <line x1="8" y1="21" x2="16" y2="21"></line>
              <line x1="12" y1="17" x2="12" y2="21"></line>
            </svg>
          </div>
          <h3 class="module-title">Recepción SINIGAN Scraper</h3>
          <div class="module-headline">De la guía al sistema en 1 clic</div>
          <ul class="module-features">
            <li>OCR + scraping certificado</li>
            <li>Carga especie, origen, vehículo, chofer</li>
            <li>Valida fechas y vigencia</li>
          </ul>
        </div>
        
        <!-- Módulo 2 -->
        <div class="module-card animate-on-scroll">
          <div class="module-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="18" height="18" rx="2" ry="2"></rect>
              <line x1="3" y1="9" x2="21" y2="9"></line>
              <line x1="9" y1="21" x2="9" y2="9"></line>
            </svg>
          </div>
          <h3 class="module-title">Checkpoints Dinámicos</h3>
          <div class="module-headline">Control minuto a minuto</div>
          <ul class="module-features">
            <li>Tablero Kanban (corrales → faena → frío → despacho)</li>
            <li>RFID/QR opcional</li>
            <li>Alertas Slack/WhatsApp si un lote se estanca</li>
          </ul>
        </div>
        
        <!-- Módulo 3 -->
        <div class="module-card animate-on-scroll">
          <div class="module-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M17 2h3a2 2 0 0 1 2 2v16a2 2 0 0 1-2 2H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h3"></path>
              <path d="M7 16h10"></path>
              <path d="M7 12h10"></path>
              <path d="M7 8h10"></path>
            </svg>
          </div>
          <h3 class="module-title">Impresión Automática de Precintos</h3>
          <div class="module-headline">100 etiquetas en 25 segundos</div>
          <ul class="module-features">
            <li>Conexión nativa Zebra / TSC / SATO</li>
            <li>Logo + código de cliente + secuencia animal</li>
            <li>Varias "plantillas de maquila" por cliente</li>
          </ul>
        </div>
        
        <!-- Módulo 4 -->
        <div class="module-card animate-on-scroll">
          <div class="module-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 6l3 1m0 0l-3 9a5.002 5.002 0 006.001 0M6 7l3 9M6 7l6-2m6 2l3-1m-3 1l-3 9a5.002 5.002 0 006.001 0M18 7l3 9m-3-9l-6-2"></path>
            </svg>
          </div>
          <h3 class="module-title">Decomisos Veterinarios</h3>
          <div class="module-headline">Registros que cierran hallazgos</div>
          <ul class="module-features">
            <li>App móvil offline</li>
            <li>Motivo + órgano + fotos</li>
            <li>Se integra al reporte de calidad</li>
          </ul>
        </div>
        
        <!-- Módulo 5 -->
        <div class="module-card animate-on-scroll">
          <div class="module-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
              <polyline points="14 2 14 8 20 8"></polyline>
              <line x1="16" y1="13" x2="8" y2="13"></line>
              <line x1="16" y1="17" x2="8" y2="17"></line>
              <polyline points="10 9 9 9 8 9"></polyline>
            </svg>
          </div>
          <h3 class="module-title">Guías de Despacho</h3>
          <div class="module-headline">Documentos listos para carretera</div>
          <ul class="module-features">
            <li>PDF + QR</li>
            <li>Campos INVIMA pre-cargados</li>
            <li>Firma digital integrada</li>
          </ul>
        </div>
        
        <!-- Módulo 6 -->
        <div class="module-card animate-on-scroll">
          <div class="module-icon">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
              <polyline points="7 10 12 15 17 10"></polyline>
              <line x1="12" y1="15" x2="12" y2="3"></line>
            </svg>
          </div>
          <h3 class="module-title">PDF Generator</h3>
          <div class="module-headline">Certificados "one-click"</div>
          <ul class="module-features">
            <li>Beneficio, calidad, animales por cliente</li>
            <li>Branding de la planta</li>
            <li>Histórico trazable</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Dashboard Section -->
  <section class="dashboard-section" id="dashboard">
    <div class="container">
      <div class="dashboard-content">
        <div class="dashboard-text animate-on-scroll">
          <h2 class="section-title">Datos vivos, decisiones rápidas</h2>
          <p class="dashboard-description">
            TracingPBA ofrece un dashboard cross-filter en tiempo real: selecciona cualquier cliente, fecha o municipio y el resto de gráficas se actualiza al instante, sin recargar la página. Perfecto para gerencia, producción y control de calidad.
          </p>
          
          <ul class="dashboard-features">
            <li>KPI "Total animales beneficiados" con trend mensual</li>
            <li>Ranking top 10 clientes</li>
            <li>Mapa de calor de municipios</li>
            <li>Estado online de cada checkpoint</li>
          </ul>
        </div>
        
        <div class="dashboard-preview animate-on-scroll">
          <div class="dashboard-monitor">
            <div class="monitor-frame">
              <div class="monitor-screen">
                <div class="dashboard-mock">
                  <div class="dashboard-header">
                    <div class="dashboard-title">TracingPBA Analytics</div>
                    <div class="dashboard-date">Tiempo real · Última actualización: <span class="update-time">hace 5 minutos</span></div>
                  </div>
                  
                  <div class="dashboard-widgets">
                    <div class="widget widget-counter">
                      <div class="widget-value counter">8,009</div>
                      <div class="widget-label">Animales beneficiados</div>
                      <div class="widget-trend positive">+12.5% vs mes anterior</div>
                    </div>
                    
                    <div class="widget widget-chart">
                      <div class="chart-container">
                        <div class="chart-bar" style="--height: 60%"></div>
                        <div class="chart-bar" style="--height: 40%"></div>
                        <div class="chart-bar" style="--height: 75%"></div>
                        <div class="chart-bar" style="--height: 55%"></div>
                        <div class="chart-bar" style="--height: 90%"></div>
                        <div class="chart-bar" style="--height: 65%"></div>
                      </div>
                      <div class="widget-label">Tendencia mensual</div>
                    </div>
                    
                    <div class="widget widget-map">
                      <div class="map-container">
                        <div class="map-region hot"></div>
                        <div class="map-region medium"></div>
                        <div class="map-region cold"></div>
                      </div>
                      <div class="widget-label">Mapa de origen</div>
                    </div>
                  </div>
                  
                  <div class="dashboard-table">
                    <div class="table-row table-header">
                      <div class="table-cell">Cliente</div>
                      <div class="table-cell">Animales</div>
                      <div class="table-cell">Estado</div>
                    </div>
                    <div class="table-row">
                      <div class="table-cell">Frigorífico Central</div>
                      <div class="table-cell">1,240</div>
                      <div class="table-cell"><span class="status complete">Completo</span></div>
                    </div>
                    <div class="table-row">
                      <div class="table-cell">Carnes del Valle</div>
                      <div class="table-cell">986</div>
                      <div class="table-cell"><span class="status in-progress">En proceso</span></div>
                    </div>
                    <div class="table-row">
                      <div class="table-cell">Distribuidora Norte</div>
                      <div class="table-cell">752</div>
                      <div class="table-cell"><span class="status complete">Completo</span></div>
                    </div>
                  </div>
                </div>
              </div>
              <div class="monitor-stand"></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Precintos Section -->
  <section class="precintos-section" id="precintos">
    <div class="container">
      <div class="precintos-content">
        <div class="precintos-visual animate-on-scroll">
          <div class="printer-simulation">
            <div class="printer-body">
              <div class="printer-head"></div>
              <div class="printer-slot">
                <div class="precinto-label">
                  <div class="precinto-content">
                    <div class="precinto-header">
                      <div class="precinto-logo">PBA</div>
                      <div class="precinto-id">T-1234</div>
                    </div>
                    <div class="precinto-data">
                      <div class="precinto-item">Cliente: C-567</div>
                      <div class="precinto-item">Fecha: 19/04/2025</div>
                      <div class="precinto-item">Lote: L-789</div>
                    </div>
                    <div class="precinto-barcode"></div>
                  </div>
                </div>
                <div class="precinto-label" style="--delay: 2s">
                  <div class="precinto-content">
                    <div class="precinto-header">
                      <div class="precinto-logo">PBA</div>
                      <div class="precinto-id">T-1235</div>
                    </div>
                    <div class="precinto-data">
                      <div class="precinto-item">Cliente: C-567</div>
                      <div class="precinto-item">Fecha: 19/04/2025</div>
                      <div class="precinto-item">Lote: L-789</div>
                    </div>
                    <div class="precinto-barcode"></div>
                  </div>
                </div>
                <div class="precinto-label" style="--delay: 4s">
                  <div class="precinto-content">
                    <div class="precinto-header">
                      <div class="precinto-logo">PBA</div>
                      <div class="precinto-id">T-1236</div>
                    </div>
                    <div class="precinto-data">
                      <div class="precinto-item">Cliente: C-567</div>
                      <div class="precinto-item">Fecha: 19/04/2025</div>
                      <div class="precinto-item">Lote: L-789</div>
                    </div>
                    <div class="precinto-barcode"></div>
                  </div>
                </div>
              </div>
            </div>
            <div class="printer-counter">
              <div class="counter-value">100</div>
              <div class="counter-label">etiquetas</div>
              <div class="counter-time">25s</div>
            </div>
          </div>
        </div>
        
        <div class="precintos-text animate-on-scroll">
          <h2 class="section-title">Personaliza y dispara: precintos que se imprimen solos</h2>
          <p class="precintos-description">
            Olvídate de abrir el software del fabricante. TracingPBA envía cada etiqueta al spool de impresión con los datos exactos: código de cliente, consecutivo animal, fechas de beneficio y vencimiento. ¿Maquila? Selecciona la plantilla y la impresora hará el resto.
          </p>
          
          <div class="precintos-metric">
            <div class="metric-value">+85%</div>
            <div class="metric-label">menos tiempo en línea de producción</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Reports Section -->
  <section class="reports-section" id="reports">
    <div class="container">
      <h2 class="section-title animate-on-scroll">Reportes, Certificados & Plantillas</h2>
      
      <div class="reports-content">
        <div class="reports-table animate-on-scroll">
          <table class="feature-table">
            <thead>
              <tr>
                <th>Tipo</th>
                <th>Qué reciben tus clientes</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td>Reporte de Información</td>
                <td>Tabla dinámica + gráficas (animales por fecha, municipio, cliente).</td>
              </tr>
              <tr>
                <td>Certificado Beneficio</td>
                <td>PDF firmado digitalmente, válido para exportaciones.</td>
              </tr>
              <tr>
                <td>Certificado Calidad</td>

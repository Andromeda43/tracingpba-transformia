---
import MainLayout from '../layouts/MainLayout.astro';
import '../styles/global.css';
import '../styles/tracingpba.css';

// Importar componentes de secciones
import Hero from '../components/Hero.astro';
import Modules from '../components/Modules.astro';
import Dashboard from '../components/Dashboard.astro';
import Precintos from '../components/Precintos.astro';
import Reportes from '../components/Reports.astro';
import Roadmap from '../components/Roadmap.astro';
import TestimoniosFaq from '../components/TestimonialsFaq.astro';
import CTA from '../components/CTA.astro';
import ProblemSolution from '../components/ProblemSolution.astro';

---

<MainLayout title="TracingPBA - Trazabilidad 360° para Plantas de Beneficio Animal | Transformia">
  <!-- Hero Section -->
  <Hero />
  
  <!-- ProblemSolution Section -->
  <section id="problemsolution" class="section-anchor">
    <ProblemSolution />
  </section>

  <!-- Módulos Section -->
  <section id="modules" class="section-anchor">
    <Modules />
  </section>
  
  <!-- Contacto Section -->
  <section id="contacto" class="section-anchor">
    <CTA />
  </section>
</MainLayout>
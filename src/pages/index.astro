<script>
  document.addEventListener('DOMContentLoaded', function() {
    // Animación al hacer scroll
    const animateOnScroll = () => {
      const elements = document.querySelectorAll('.animate-on-scroll');
      
      elements.forEach(element => {
        const elementPosition = element.getBoundingClientRect().top;
        const windowHeight = window.innerHeight;
        
        if (elementPosition < windowHeight * 0.85) {
          element.classList.add('visible');
        }
      });
    };
    
    // Counters animados
    const animateCounters = () => {
      const counters = document.querySelectorAll('.counter-value');
      
      counters.forEach(counter => {
        const target = parseFloat(counter.getAttribute('data-value') || counter.innerText.replace(/[^\d.-]/g, ''));
        const increment = target / 100;
        
        let currentValue = 0;
        
        const updateCounter = () => {
          if (currentValue < target) {
            currentValue += increment;
            if (currentValue > target) currentValue = target;
            
            // Formatear según el tipo de valor
            let formattedValue = currentValue.toLocaleString('es-CO', {
              minimumFractionDigits: currentValue % 1 === 0 ? 0 : 2,
              maximumFractionDigits: 2
            });
            
            // Agregar el signo + para métricas que lo necesiten
            if (counter.innerText.includes('+')) {
              formattedValue += '+';
            }
            
            // Agregar el signo % para porcentajes
            if (counter.innerText.includes('%')) {
              formattedValue += '%';
            }
            
            counter.innerText = formattedValue;
            requestAnimationFrame(updateCounter);
          }
        };
        
        updateCounter();
      });
    };
    
    // Inicializar animaciones
    animateOnScroll();
    window.addEventListener('scroll', animateOnScroll);
    
    // FAQ acordeón
    const faqItems = document.querySelectorAll('.faq-question');
    faqItems.forEach(item => {
      item.addEventListener('click', () => {
        const parent = item.parentElement;
        parent.classList.toggle('active');
        
        // Actualizar el icono
        const icon = item.querySelector('.question-icon');
        icon.textContent = parent.classList.contains('active') ? '−' : '+';
      });
    });
    
    // Mostrar contador cuando sea visible
    const metricsSection = document.querySelector('.metrics-container');
    const observerOptions = {
      threshold: 0.5
    };
    
    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          animateCounters();
          observer.unobserve(entry.target);
        }
      });
    }, observerOptions);
    
    if (metricsSection) {
      observer.observe(metricsSection);
    }
    
    // Efecto typing para el terminal
    document.querySelector('.typing-effect').classList.add('typing');
    
    // Añadir clase para indicar que el DOM está cargado
    document.body.classList.add('dom-loaded');
  });
</script>